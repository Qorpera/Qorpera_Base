# Cloudflare Pages response headers for app.qorpera.com.
# The build replaces the connect-src marker from the same validated public
# configuration compiled into the client. Inline styles are
# not used (element.style is CSSOM and is not governed by style-src).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' __QORPERA_WEB_CONNECT_SRC__; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/build/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
