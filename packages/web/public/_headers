# Cloudflare Pages response headers for app.qorpera.com.
# The build replaces the connect-src marker from the same validated public
# configuration compiled into the client. Inline styles are
# not used (element.style is CSSOM and is not governed by style-src).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' __QORPERA_WEB_CONNECT_SRC__; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate
# The app itself may use the microphone, for the composer's speech to text (src/ui/dictation.ts).
# The frame an HTML page from the Company File runs in (src/ui/page-frame.ts): sandboxed with no origin, so the page
# reaches none of this site's cookies, storage or sign-in; its own inline styles and scripts run, nothing loads from
# the network, and only this site may frame it. Every other page here refuses to be framed.
/page-preview/*
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' blob:; style-src 'unsafe-inline' data:; img-src data: blob:; font-src data: blob:; media-src data: blob:; connect-src data: blob:; worker-src blob: data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
# The site door (src/app/views/site-view.ts; company views step 4): a company's website shows inside Qorpera in a frame
# this page holds, on the site's own host. The app frames only this site; the door alone frames the sites' hosts, so no
# other frame of the app (a Company File page, an interface app) may go to one. The site's host takes a member's pass
# only with this site's exact Origin, and the app sends no referrer, under which a form's Origin is null: so the door
# alone sends its origin (strict-origin: never a path), may post only to the one path of a site's host that takes a
# pass, runs only its own script, and only this site frames it. A policy can name no narrower set of hosts than one
# wildcard label; each site says itself who may frame it (frame-ancestors on its own host: this app's origins only).
# Pages applies /* first: its policy, framing refusal and referrer policy are taken off before these.
/site-door/*
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Referrer-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; frame-src https://*.qorpera.com; base-uri 'none'; form-action https://*.qorpera.com/__qorpera/member; frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/build/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
