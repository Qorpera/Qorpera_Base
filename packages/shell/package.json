{
	"name": "@qorpera/shell",
	"version": "0.83.0",
	"private": true,
	"type": "module",
	"description": "Qorpera Base shell — the desktop host for agent-operated companies.",
	"main": "dist/main.js",
	"scripts": {
		"build": "tsgo -p tsconfig.build.json && shx rm -rf dist/userland dist/assets && shx cp -r userland dist/userland && shx cp -r assets dist/assets && shx cp ../../node_modules/marked/lib/marked.umd.js dist/userland/marked.umd.js && shx cp src/preload.cjs dist/preload.cjs",
		"start": "electron dist/main.js",
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"test": "vitest run"
	},
	"dependencies": {
		"@openai/codex": "0.155.1",
		"@qorpera/company": "^0.83.0",
		"@qorpera/contracts": "^0.83.0",
		"@qorpera/pi-ai": "^0.83.0",
		"@qorpera/pi-coding-agent": "^0.83.0",
		"@qorpera/pi-protocol": "^0.83.0",
		"@supabase/supabase-js": "2.112.3",
		"electron-updater": "6.8.9",
		"marked": "18.0.5",
		"pg": "8.23.0",
		"playwright-core": "1.62.1",
		"@qorpera/cloud-client": "^0.83.0"
	},
	"devDependencies": {
		"@openai/codex-boundary-test": "npm:@openai/codex@0.155.1",
		"@types/pg": "8.23.1",
		"electron": "43.2.0",
		"electron-builder": "26.15.3",
		"shx": "0.4.0",
		"vitest": "4.1.11"
	},
	"productVersion": "0.20.44"
}
