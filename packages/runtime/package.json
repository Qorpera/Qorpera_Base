{
	"name": "@qorpera/runtime",
	"version": "0.83.0",
	"private": true,
	"type": "module",
	"description": "Headless Qorpera cloud execution and shared office services.",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"dependencies": {
		"@qorpera/contracts": "^0.83.0",
		"@qorpera/company": "^0.83.0",
		"@supabase/supabase-js": "2.112.3",
		"@qorpera/cloud-client": "^0.83.0",
		"image-in-browser": "3.6.0",
		"pg": "8.23.0",
		"playwright-core": "1.62.1"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"shx": "0.4.0",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
