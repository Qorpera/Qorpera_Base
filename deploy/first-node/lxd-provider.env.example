QORPERA_RUNNER_PROVIDER_BACKEND=lxd
QORPERA_RUNNER_PROVIDER_ADAPTER=lxd
QORPERA_RUNNER_PROVIDER_TOKEN=REPLACE_WITH_ORCHESTRATOR_TO_PROVIDER_CAPABILITY
QORPERA_RUNNER_PROVIDER_HOST=10.41.0.1
QORPERA_RUNNER_PROVIDER_PORT=8081
QORPERA_RUNNER_PROVIDER_TRUSTED_SOURCE=10.41.0.2
QORPERA_RUNNER_PROVIDER_TLS_CERT=/etc/qorpera/runner-provider.crt
QORPERA_RUNNER_PROVIDER_TLS_KEY=/etc/qorpera/runner-provider.key

QORPERA_SUPABASE_URL=https://REPLACE.supabase.co
QORPERA_SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVICE_ROLE_SECRET
QORPERA_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY

QORPERA_RUNNER_PROVIDER_STATE_ROOT=/var/lib/qorpera-provider/runs
QORPERA_LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket
QORPERA_LXD_OPERATION_TIMEOUT_SECONDS=120
QORPERA_LXD_PROJECT=qorpera-runners
QORPERA_LXD_JOB_PROFILE=qorpera-job-v1
QORPERA_LXD_LOGIN_PROFILE=qorpera-login-v1
QORPERA_LXD_NETWORK_INTERFACE=enp5s0
QORPERA_LXD_IMAGE_SERVER=local
QORPERA_LXD_IMAGE_FINGERPRINT=REPLACE_WITH_64_HEX_IMAGE_FINGERPRINT
QORPERA_LXD_GUEST_PACKAGE_MANIFEST_SHA256=REPLACE_WITH_64_HEX_GUEST_PACKAGE_MANIFEST_DIGEST
QORPERA_LXD_IMAGE_PROVENANCE=/etc/qorpera/lxd-image-provenance.json
QORPERA_LXD_IMAGE_PROVENANCE_PUBLIC_KEY=/etc/qorpera/lxd-image-provenance.pub
QORPERA_LXD_STORAGE_POOL=qorpera-vm
QORPERA_LXD_IDENTITY_VOLUME_PREFIX=identity-
QORPERA_LXD_IDENTITY_VOLUME_SIZE=32GiB
QORPERA_LXD_ROOT_DISK_SIZE=80GiB
QORPERA_LXD_CPU_LIMIT=4
QORPERA_LXD_MEMORY_LIMIT=8GiB
QORPERA_LXD_GUEST_ASSIGNMENT_PORT=8082
QORPERA_LXD_GUEST_ASSIGNMENT_SOURCE=10.41.0.1
QORPERA_LXD_NATIVE_BRIDGE_PORT=8083
QORPERA_LXD_NATIVE_EXECUTION_GID=42041
QORPERA_LXD_GUEST_READY_TIMEOUT_MS=300000
QORPERA_LXD_GUEST_BOOTSTRAP_SERVICE=qorpera-lxd-runner-bootstrap.service
QORPERA_LXD_LOGIN_STATE_ROOT=/var/lib/qorpera-provider/logins
QORPERA_LXD_LOGIN_GATEWAY_HOST=127.0.0.1
QORPERA_LXD_LOGIN_GATEWAY_PORT=18082
QORPERA_LXD_LOGIN_BOOTSTRAP_SERVICE=qorpera-lxd-native-login-bootstrap.service

# Governed Company Computer runtime. This block is all-or-nothing. The two
# bearer values are read from separate root-only files and are never accepted
# directly from the provider environment.
QORPERA_NATIVE_RUNTIME=company-path-v1
QORPERA_NATIVE_CODEX_FENCE_PATH=/opt/qorpera-harnesses/native-company/codex
QORPERA_NATIVE_CODEX_FENCE_SHA256=2f2c26cfdfacebbcce848fb50cfaaa4e8d0aa3c6ec3c1009123ecf766c8335f7
QORPERA_NATIVE_OBJECT_GATEWAY_URL=https://objects.replace.invalid
QORPERA_LXD_NATIVE_OBJECT_TOKEN_FILE=/etc/qorpera/native-object-gateway-token
QORPERA_LXD_COMPANY_NETWORK=qorpera0
QORPERA_LXD_RECOVERY_VOLUME_PREFIX=recovery-
QORPERA_LXD_RECOVERY_VOLUME_SIZE=32GiB
QORPERA_CLOUD_SECRET_BROKER_URL=https://secrets.replace.invalid
QORPERA_LXD_CLOUD_SECRET_RUNTIME_TOKEN_FILE=/etc/qorpera/cloud-secret-runtime-token
QORPERA_LXD_CLOUD_SECRET_CA_FILE=/etc/qorpera/cloud-secret-broker-ca.crt
QORPERA_LXD_CLOUD_SECRET_CA_SHA256=REPLACE_WITH_64_HEX_CA_CERTIFICATE_DIGEST

# Optional office transport for native jobs; see native-office-routes.md.
# The provider selects only the exact company + environment route per job.
# QORPERA_LXD_OFFICE_ROUTES_FILE=/etc/qorpera/native-office-routes.json

QORPERA_EPHEMERAL_RUNNER_IMAGE=REPLACE_WITH_REGISTRY_IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST
QORPERA_EPHEMERAL_RUNNER_IMAGE_ARCHIVE_SHA256=REPLACE_WITH_64_HEX_OCI_ARCHIVE_DIGEST
QORPERA_EPHEMERAL_RUNNER_IMAGE_COSIGN_BUNDLE_SHA256=REPLACE_WITH_64_HEX_COSIGN_BUNDLE_DIGEST
QORPERA_EPHEMERAL_RUNNER_PODMAN=/usr/bin/podman
QORPERA_EPHEMERAL_RUNNER_ENTRYPOINT=/qorpera/bin/run-job
QORPERA_EPHEMERAL_RUNNER_VERSION=REPLACE_WITH_SIGNED_RUNNER_VERSION
QORPERA_CODEX_PATH=/usr/local/bin/codex
QORPERA_CLAUDE_PATH=/usr/local/bin/claude
