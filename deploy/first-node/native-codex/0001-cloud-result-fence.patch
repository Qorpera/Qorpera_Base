diff --git a/codex-rs/core/src/qorpera_message_composition.rs b/codex-rs/core/src/qorpera_message_composition.rs
new file mode 100644
index 000000000..75c17fc4e
--- /dev/null
+++ b/codex-rs/core/src/qorpera_message_composition.rs
@@ -0,0 +1,178 @@
+//! Optional metadata for public-message composition, independent of tool execution.
+use std::collections::BTreeSet;
+
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::QorperaMessageCompositionEvent;
+use codex_protocol::protocol::QorperaMessageCompositionPhase;
+
+const MAX_CALLS: usize = 256;
+
+pub(crate) struct PublicMessageComposition {
+    enabled: bool,
+    active: BTreeSet<String>,
+}
+
+impl PublicMessageComposition {
+    pub(crate) fn new(enabled: bool) -> Self {
+        Self {
+            enabled,
+            active: BTreeSet::new(),
+        }
+    }
+
+    pub(crate) fn added(&mut self, item: &ResponseItem) -> Option<QorperaMessageCompositionEvent> {
+        if !self.enabled || self.active.len() >= MAX_CALLS {
+            return None;
+        }
+        let ResponseItem::FunctionCall {
+            name,
+            namespace,
+            call_id,
+            ..
+        } = item
+        else {
+            return None;
+        };
+        if namespace.as_deref() != Some("qorpera")
+            || name != "send_message"
+            || call_id.is_empty()
+            || call_id.len() > 256
+            || !self.active.insert(call_id.clone())
+        {
+            return None;
+        }
+        Some(QorperaMessageCompositionEvent {
+            call_id: call_id.clone(),
+            phase: QorperaMessageCompositionPhase::Start,
+        })
+    }
+
+    pub(crate) fn done(&mut self, item: &ResponseItem) -> Option<QorperaMessageCompositionEvent> {
+        let ResponseItem::FunctionCall { call_id, .. } = item else {
+            return None;
+        };
+        self.active
+            .remove(call_id)
+            .then(|| QorperaMessageCompositionEvent {
+                call_id: call_id.clone(),
+                phase: QorperaMessageCompositionPhase::Finish,
+            })
+    }
+
+    pub(crate) fn finish(&mut self) -> Vec<QorperaMessageCompositionEvent> {
+        std::mem::take(&mut self.active)
+            .into_iter()
+            .map(|call_id| QorperaMessageCompositionEvent {
+                call_id,
+                phase: QorperaMessageCompositionPhase::Finish,
+            })
+            .collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn call(id: &str, namespace: Option<&str>, name: &str, arguments: &str) -> ResponseItem {
+        serde_json::from_value(json!({
+            "type": "function_call", "id": format!("fc_{id}"), "call_id": id,
+            "namespace": namespace, "name": name, "arguments": arguments,
+        }))
+        .unwrap()
+    }
+
+    #[test]
+    fn starts_before_arguments_and_finishes_before_dispatch() {
+        let mut tracker = PublicMessageComposition::new(true);
+        let added = call("call_one", Some("qorpera"), "send_message", "");
+        let start = tracker.added(&added).unwrap();
+        assert_eq!(start.phase, QorperaMessageCompositionPhase::Start);
+        assert!(tracker.added(&added).is_none());
+        let done = call(
+            "call_one",
+            Some("qorpera"),
+            "send_message",
+            r#"{"text":"private until sent"}"#,
+        );
+        let end = tracker.done(&done).unwrap();
+        assert_eq!(end.phase, QorperaMessageCompositionPhase::Finish);
+        assert!(tracker.done(&done).is_none());
+        assert!(tracker.finish().is_empty());
+        assert_eq!(
+            serde_json::to_value(start).unwrap(),
+            json!({"call_id":"call_one","phase":"start"})
+        );
+        assert_eq!(
+            serde_json::to_value(end).unwrap(),
+            json!({"call_id":"call_one","phase":"finish"})
+        );
+    }
+
+    #[test]
+    fn ordinary_sessions_and_other_calls_never_animate_public_writing() {
+        let send = call("call_one", Some("qorpera"), "send_message", "");
+        assert!(PublicMessageComposition::new(false).added(&send).is_none());
+        let mut tracker = PublicMessageComposition::new(true);
+        for item in [
+            call("call_one", Some("qorpera"), "company_write", ""),
+            call("call_two", None, "send_message", ""),
+            call("call_three", Some("other"), "send_message", ""),
+            call("", Some("qorpera"), "send_message", ""),
+            call(&"a".repeat(257), Some("qorpera"), "send_message", ""),
+        ] {
+            assert!(tracker.added(&item).is_none());
+        }
+        assert!(tracker.finish().is_empty());
+    }
+
+    #[test]
+    fn failed_closed_cancelled_or_completed_stream_drains_all_incomplete_calls() {
+        let mut tracker = PublicMessageComposition::new(true);
+        for id in ["call_one", "call_two"] {
+            assert!(
+                tracker
+                    .added(&call(id, Some("qorpera"), "send_message", ""))
+                    .is_some()
+            );
+        }
+        let ended = tracker.finish();
+        assert_eq!(ended.len(), 2);
+        assert!(
+            ended
+                .iter()
+                .all(|event| event.phase == QorperaMessageCompositionPhase::Finish)
+        );
+        assert!(tracker.finish().is_empty());
+        // A retry has fresh state, including if the upstream reuses a call ID.
+        assert!(
+            tracker
+                .added(&call("call_one", Some("qorpera"), "send_message", ""))
+                .is_some()
+        );
+    }
+
+    #[test]
+    fn bounds_optional_metadata_without_rejecting_tool_execution() {
+        let mut tracker = PublicMessageComposition::new(true);
+        for index in 0..MAX_CALLS {
+            assert!(
+                tracker
+                    .added(&call(
+                        &format!("call_{index}"),
+                        Some("qorpera"),
+                        "send_message",
+                        ""
+                    ))
+                    .is_some()
+            );
+        }
+        assert!(
+            tracker
+                .added(&call("overflow", Some("qorpera"), "send_message", ""))
+                .is_none()
+        );
+        assert_eq!(tracker.finish().len(), MAX_CALLS);
+    }
+}
diff --git a/codex-rs/core/src/qorpera_result_fence.rs b/codex-rs/core/src/qorpera_result_fence.rs
new file mode 100644
index 000000000..4a60a6777
--- /dev/null
+++ b/codex-rs/core/src/qorpera_result_fence.rs
@@ -0,0 +1,385 @@
+//! Private cloud result boundary. This has no access to provider credentials or transports.
+//! The Qorpera host enables it only in a pinned, isolated app-server process.
+
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::openai_models::ToolMode;
+
+use crate::responses_metadata::CodexResponsesMetadata;
+
+/// Governed runs expose only their host-registered direct tools. Model metadata
+/// must not advertise code execution when that execution host is unavailable.
+/// Socket validity and current authority are still checked before every request.
+pub(crate) fn governed_tool_mode(
+    socket: Option<&std::ffi::OsStr>,
+    requested: ToolMode,
+) -> ToolMode {
+    if socket.is_some() {
+        ToolMode::Direct
+    } else {
+        requested
+    }
+}
+
+/// Governed runs expose only the tools the cloud runtime brokers; the native helper tools the model
+/// catalog advertises (clock, async user questions, async user messages) are never registered there.
+pub(crate) fn native_helper_tools_allowed(socket: Option<&std::ffi::OsStr>) -> bool {
+    socket.is_none()
+}
+
+pub(crate) async fn fence_results(
+    input: &mut [ResponseItem],
+    metadata: &CodexResponsesMetadata,
+) -> Result<()> {
+    let Some(socket) = std::env::var_os("QORPERA_NATIVE_RESULT_FENCE_SOCKET") else {
+        return Ok(());
+    };
+    #[cfg(unix)]
+    {
+        unix::fence(input, metadata, std::path::Path::new(&socket))
+            .await
+            .map_err(|_| CodexErr::Fatal("Cloud result boundary unavailable".to_string()))
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = (socket, input, metadata);
+        Err(CodexErr::Fatal(
+            "Cloud result boundary requires a Unix host".to_string(),
+        ))
+    }
+}
