+}
+
+#[tokio::test]
+async fn stalled_host_cannot_hold_the_model_request_open_indefinitely() {
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("f.sock");
+    let listener = UnixListener::bind(&path).unwrap();
+    let host = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        std::future::pending::<()>().await;
+        drop(stream);
+    });
+    let started = std::time::Instant::now();
+    assert_eq!(
+        fence(&mut history().unwrap(), &metadata(), &path).await,
+        Err(())
+    );
+    assert!(started.elapsed() < std::time::Duration::from_secs(7));
+    host.abort();
+}
+
+#[tokio::test]
+async fn a_request_with_any_number_of_tool_outputs_is_fenced_whole() {
+    // No count of tool outputs per model request (was fewer than 128, and at most
+    // 1 MiB of result text): 300 outputs of 7,000 bytes, about 2 MB, are fenced.
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("f.sock");
+    let mut items = Vec::new();
+    for index in 0..300 {
+        items.push(json!({"type":"function_call","call_id":format!("call-{index}"),"name":"unsupported","arguments":"{}"}));
+        items.push(json!({"type":"function_call_output","call_id":format!("call-{index}"),"output":"x".repeat(7000)}));
+    }
+    let mut input: Vec<ResponseItem> = serde_json::from_value(Value::Array(items)).unwrap();
+    let listener = UnixListener::bind(&path).unwrap();
+    let host = tokio::spawn(reply(listener, "none"));
+    assert_eq!(fence(&mut input, &metadata(), &path).await, Ok(()));
+    let request = host.await.unwrap().unwrap();
+    assert_eq!(request["outputs"].as_array().unwrap().len(), 300);
+}
