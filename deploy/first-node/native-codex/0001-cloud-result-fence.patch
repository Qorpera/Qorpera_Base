+#[cfg(unix)]
+mod unix {
+    use std::path::Path;
+    use std::time::Duration;
+
+    use base64::Engine;
+    use base64::engine::general_purpose::STANDARD;
+    use codex_protocol::models::ContentItem;
+    use codex_protocol::models::FunctionCallOutputBody;
+    use codex_protocol::models::FunctionCallOutputContentItem;
+    use codex_protocol::models::ImageDetail;
+    use codex_protocol::models::ResponseItem;
+    use serde::Deserialize;
+    use serde::Serialize;
+    use sha2::Digest;
+    use sha2::Sha256;
+    use tokio::io::AsyncReadExt;
+    use tokio::io::AsyncWriteExt;
+    use tokio::net::UnixStream;
+    use uuid::Uuid;
+
+    use crate::responses_metadata::CodexResponsesMetadata;
+    use crate::responses_metadata::CodexResponsesRequestKind;
+
+    const SCHEMA: &str = "qorpera.native-result-fence/v1";
+    const MAX_FRAME_BYTES: usize = 64 * 1024 * 1024;
+    const MAX_SOURCE_BYTES: usize = 64 * 1024 * 1024;
+    const MAX_RESULT_BYTES: usize = 8 * 1024;
+    const MAX_IMAGE_BYTES: usize = 8 * 1024 * 1024;
+    const MAX_IMAGE_BATCH_BYTES: usize = 128 * 1024 * 1024;
+    const DEADLINE: Duration = Duration::from_secs(5);
+
+    #[derive(Clone, Copy, Deserialize, PartialEq, Serialize)]
+    #[serde(rename_all = "snake_case")]
+    enum Kind {
+        FunctionCallOutput,
+        CustomToolCallOutput,
+    }
+
+    #[derive(Serialize)]
+    #[serde(rename_all = "camelCase")]
+    struct Output<'a> {
+        kind: Kind,
+        call_id: &'a str,
+        output: Body<'a>,
+    }
+
+    // Pixels remain in native history for native image budgeting/compaction.
+    // Only their digest crosses the private authority/audit socket.
+    #[derive(Serialize)]
+    #[serde(untagged)]
+    enum Body<'a> {
+        Text(&'a str),
+        Items(Vec<Content<'a>>),
+    }
+
+    #[derive(Serialize)]
+    #[serde(tag = "type", rename_all = "snake_case")]
+    enum Content<'a> {
+        InputText { text: &'a str },
+        InputImage { sha256: String },
+    }
+
+    impl Body<'_> {
+        fn image_sha256(&self) -> Option<&str> {
+            match self {
+                Self::Text(_) => None,
+                Self::Items(items) => items.iter().find_map(|item| match item {
+                    Content::InputText { .. } => None,
+                    Content::InputImage { sha256 } => Some(sha256.as_str()),
+                }),
+            }
+        }
+    }
+
+    #[derive(Serialize)]
+    #[serde(rename_all = "camelCase")]
+    struct Request<'a> {
+        schema: &'static str,
+        request_id: String,
+        thread_id: &'a str,
+        turn_id: Option<&'a str>,
+        purpose: &'static str,
+        outputs: Vec<Output<'a>>,
+    }
+
+    #[derive(Deserialize)]
+    #[serde(rename_all = "camelCase", deny_unknown_fields)]
+    struct Reply {
+        schema: String,
+        request_id: String,
+        thread_id: String,
+        turn_id: Option<String>,
+        outputs: Vec<FencedOutput>,
+    }
+
+    #[derive(Deserialize)]
+    #[serde(rename_all = "camelCase", deny_unknown_fields)]
+    struct FencedOutput {
+        kind: Kind,
+        call_id: String,
+        output: String,
+        image_sha256: Option<String>,
+    }
+
+    pub(super) async fn fence(
+        input: &mut [ResponseItem],
+        metadata: &CodexResponsesMetadata,
+        socket: &Path,
+    ) -> std::result::Result<(), ()> {
+        if !socket.is_absolute() {
+            return Err(());
+        }
+        let mut outputs = Vec::new();
+        let mut indexes = Vec::new();
+        let mut source_bytes = 0;
+        let mut image_bytes = 0;
+        for (index, item) in input.iter().enumerate() {
+            let (kind, call_id, output) = match item {
+                // A function call output without a call id (upstream now allows one)
+                // cannot be bound to an issued result and is refused below as empty.
+                ResponseItem::FunctionCallOutput {
+                    call_id, output, ..
+                } => (
+                    Kind::FunctionCallOutput,
+                    call_id.as_deref().unwrap_or(""),
+                    output,
+                ),
+                ResponseItem::CustomToolCallOutput {
+                    call_id, output, ..
+                } => (Kind::CustomToolCallOutput, call_id.as_str(), output),
+                // These surfaces are not admitted by this cloud adapter. Never silently
+                // pass an unhandled result or a newly introduced item to the provider.
+                ResponseItem::AgentMessage { .. }
+                | ResponseItem::LocalShellCall { .. }
+                | ResponseItem::ToolSearchCall { .. }
+                | ResponseItem::ToolSearchOutput { .. }
+                | ResponseItem::WebSearchCall { .. }
+                | ResponseItem::ImageGenerationCall { .. }
+                | ResponseItem::Other => return Err(()),
+                // The host admits initial text only. Captures are issued through
+                // exact tool results; provider messages cannot create another media path.
+                ResponseItem::Message { content, .. } => {
+                    for item in content {
+                        match item {
+                            ContentItem::InputText { .. } | ContentItem::OutputText { .. } => {}
+                            ContentItem::InputImage { .. } | ContentItem::InputAudio { .. } => {
+                                return Err(());
+                            }
+                        }
+                    }
+                    continue;
+                }
+                ResponseItem::AdditionalTools { .. }
+                | ResponseItem::Reasoning { .. }
+                | ResponseItem::FunctionCall { .. }
+                | ResponseItem::CustomToolCall { .. }
+                | ResponseItem::Compaction { .. }
+                | ResponseItem::CompactionTrigger { .. }
+                | ResponseItem::ContextCompaction { .. }
+                // Upstream 0.155: a configuration update item carries no tool result.
+                | ResponseItem::ConfigurationUpdate { .. } => continue,
+            };
+            if call_id.is_empty() || call_id.len() > 160 {
+                return Err(());
+            }
+            let body = match &output.body {
+                FunctionCallOutputBody::Text(text) => {
+                    source_bytes += text.len();
+                    Body::Text(text.as_str())
+                }
+                FunctionCallOutputBody::ContentItems(items) => {
+                    if items.len() > 16 {
+                        return Err(());
+                    }
+                    let mut content = Vec::new();
+                    for (position, item) in items.iter().enumerate() {
+                        match item {
+                            FunctionCallOutputContentItem::InputText { text } => {
+                                source_bytes += text.len();
+                                content.push(Content::InputText { text });
+                            }
+                            FunctionCallOutputContentItem::InputImage { image_url, detail } => {
+                                // One capture accompanies one bounded, host-fenced text
+                                // envelope. No URLs, audio, arbitrary detail or image-only output.
+                                if position != 1
+                                    || items.len() != 2
+                                    || *detail != Some(ImageDetail::High)
+                                {
+                                    return Err(());
+                                }
+                                let Some(FunctionCallOutputContentItem::InputText { text }) =
+                                    items.first()
+                                else {
+                                    return Err(());
+                                };
+                                if text.len() > MAX_RESULT_BYTES {
+                                    return Err(());
+                                }
+                                let encoded =
+                                    image_url.strip_prefix("data:image/png;base64,").ok_or(())?;
+                                if encoded.len() > MAX_IMAGE_BYTES.div_ceil(3) * 4 {
+                                    return Err(());
+                                }
+                                let bytes = STANDARD.decode(encoded).map_err(|_| ())?;
+                                if bytes.len() < 33
+                                    || bytes.len() > MAX_IMAGE_BYTES
+                                    || STANDARD.encode(&bytes) != encoded
+                                    || &bytes[..16] != b"\x89PNG\r\n\x1a\n\0\0\0\rIHDR"
+                                {
+                                    return Err(());
+                                }
+                                let width =
+                                    u32::from_be_bytes(bytes[16..20].try_into().map_err(|_| ())?);
+                                let height =
+                                    u32::from_be_bytes(bytes[20..24].try_into().map_err(|_| ())?);
+                                if !(1..=1920).contains(&width) || !(1..=1200).contains(&height) {
+                                    return Err(());
+                                }
+                                image_bytes += bytes.len();
+                                if image_bytes > MAX_IMAGE_BATCH_BYTES {
+                                    return Err(());
+                                }
+                                content.push(Content::InputImage {
+                                    sha256: format!("{:x}", Sha256::digest(&bytes)),
+                                });
+                            }
+                            FunctionCallOutputContentItem::InputAudio { .. }
+                            | FunctionCallOutputContentItem::EncryptedContent { .. } => {
+                                return Err(());
+                            }
+                        }
+                    }
+                    Body::Items(content)
+                }
+            };
+            if source_bytes > MAX_SOURCE_BYTES {
+                return Err(());
+            }
+            indexes.push(index);
+            outputs.push(Output {
+                kind,
+                call_id,
+                output: body,
+            });
+        }
+        let purpose = match metadata.request_kind {
+            Some(CodexResponsesRequestKind::Prewarm) => "prewarm",
+            Some(CodexResponsesRequestKind::Compaction(_)) => "compaction",
+            Some(CodexResponsesRequestKind::Memory) => return Err(()),
+            Some(CodexResponsesRequestKind::Turn) | None => "turn",
+        };
+        let request = Request {
+            schema: SCHEMA,
+            request_id: Uuid::new_v4().to_string(),
+            thread_id: &metadata.thread_id,
+            turn_id: metadata.turn_id.as_deref(),
+            purpose,
+            outputs,
+        };
+        let wire = serde_json::to_vec(&request).map_err(|_| ())?;
+        if wire.len() > MAX_FRAME_BYTES {
+            return Err(());
+        }
+        // Even an empty first request requires a live host acknowledgement. This is
+        // outside the provider HTTP/WS layer and never forwards its authorization.
+        let reply: Reply = tokio::time::timeout(DEADLINE, async {
+            let mut stream = UnixStream::connect(socket).await.map_err(|_| ())?;
+            stream.write_u32(wire.len() as u32).await.map_err(|_| ())?;
+            stream.write_all(&wire).await.map_err(|_| ())?;
+            let size = stream.read_u32().await.map_err(|_| ())? as usize;
+            if size == 0 || size > MAX_FRAME_BYTES {
+                return Err(());
+            }
+            let mut bytes = vec![0; size];
+            stream.read_exact(&mut bytes).await.map_err(|_| ())?;
+            serde_json::from_slice(&bytes).map_err(|_| ())
+        })
+        .await
+        .map_err(|_| ())??;
+        if reply.schema != SCHEMA
+            || reply.request_id != request.request_id
+            || reply.thread_id != request.thread_id
+            || reply.turn_id.as_deref() != request.turn_id
+            || reply.outputs.len() != request.outputs.len()
+        {
+            return Err(());
+        }
+        // Validate the whole batch before replacing any body. Names, calls, roles,
+        // instructions, model settings and credentials cannot be rewritten here.
+        for (fenced, original) in reply.outputs.iter().zip(&request.outputs) {
+            if fenced.kind != original.kind
+                || fenced.call_id != original.call_id
+                || fenced.output.len() > MAX_RESULT_BYTES
+                || fenced.image_sha256.as_deref() != original.output.image_sha256()
+            {
+                return Err(());
+            }
+            let envelope: serde_json::Value =
+                serde_json::from_str(&fenced.output).map_err(|_| ())?;
+            if envelope["schema"] != "qorpera.cloud-tool-result/v1"
+                || envelope["trust"] != "untrusted_data"
+                || envelope["provenance"]["callId"] != fenced.call_id
+            {
+                return Err(());
+            }
+        }
+        for (fenced, index) in reply.outputs.into_iter().zip(indexes) {
+            if let ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } = &mut input[index]
+            {
+                output.body = if fenced.image_sha256.is_some() {
+                    let FunctionCallOutputBody::ContentItems(items) = &output.body else {
+                        return Err(());
+                    };
+                    FunctionCallOutputBody::ContentItems(vec![
+                        FunctionCallOutputContentItem::InputText {
+                            text: fenced.output,
+                        },
+                        items[1].clone(),
+                    ])
+                } else {
+                    FunctionCallOutputBody::Text(fenced.output)
+                };
+            }
+        }
+        Ok(())
+    }
+}
