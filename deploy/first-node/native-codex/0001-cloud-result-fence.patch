+#[test]
+fn maximum_capture_envelope_keeps_native_context_bounded() {
+    // The host sends canonical JSON, whose embedded quotation marks are escaped
+    // again in a model request. Exercise that expansion at the 8 KiB result cap.
+    let mut value = serde_json::to_value(capture_history().unwrap()).unwrap();
+    let text = json!({"text": "\"".repeat(4080)}).to_string();
+    assert!((8100..=8192).contains(&text.len()));
+    value[0]["output"][0]["text"] = json!(text);
+    let small: Vec<ResponseItem> = serde_json::from_value(value.clone()).unwrap();
+    // Synthetic bytes test accounting only; PNG validity is covered separately.
+    let encoded = STANDARD.encode(vec![0_u8; 8 * 1024 * 1024]);
+    value[0]["output"][1]["image_url"] = json!(format!("data:image/png;base64,{encoded}"));
+    let large: Vec<ResponseItem> = serde_json::from_value(value).unwrap();
+    let tokens = crate::context_manager::estimate_item_token_count(&large[0]);
+    assert_eq!(
+        tokens,
+        crate::context_manager::estimate_item_token_count(&small[0])
+    );
+    assert!((1001..10_000).contains(&tokens));
+}
