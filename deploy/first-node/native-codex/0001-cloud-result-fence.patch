+        let original = input.clone();
+        let host = tokio::spawn(reply(listener, fault));
+        assert_eq!(
+            fence(&mut input, &metadata(), &path).await,
+            Err(()),
+            "{fault}"
+        );
+        assert_eq!(input, original, "{fault}");
+        host.await.unwrap().unwrap();
+    }
