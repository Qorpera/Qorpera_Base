@@ -0,0 +1,244 @@
+//! Private cloud result boundary. This has no access to provider credentials or transports.
+//! The Qorpera host enables it only in a pinned, isolated app-server process.
+
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::models::ResponseItem;
+
+use crate::responses_metadata::CodexResponsesMetadata;
+
+pub(crate) async fn fence_results(
+    input: &mut [ResponseItem],
+    metadata: &CodexResponsesMetadata,
+) -> Result<()> {
+    let Some(socket) = std::env::var_os("QORPERA_NATIVE_RESULT_FENCE_SOCKET") else {
+        return Ok(());
+    };
+    #[cfg(unix)]
+    {
+        unix::fence(input, metadata, std::path::Path::new(&socket))
+            .await
+            .map_err(|_| CodexErr::Fatal("Cloud result boundary unavailable".to_string()))
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = (socket, input, metadata);
+        Err(CodexErr::Fatal(
+            "Cloud result boundary requires a Unix host".to_string(),
+        ))
+    }
+}
+
+#[cfg(unix)]
+mod unix {
+    use std::path::Path;
+    use std::time::Duration;
+
+    use codex_protocol::models::FunctionCallOutputBody;
+    use codex_protocol::models::FunctionCallOutputContentItem;
+    use codex_protocol::models::FunctionCallOutputPayload;
+    use codex_protocol::models::ResponseItem;
+    use serde::Deserialize;
+    use serde::Serialize;
+    use tokio::io::AsyncReadExt;
+    use tokio::io::AsyncWriteExt;
+    use tokio::net::UnixStream;
+    use uuid::Uuid;
+
+    use crate::responses_metadata::CodexResponsesMetadata;
+    use crate::responses_metadata::CodexResponsesRequestKind;
+
+    const SCHEMA: &str = "qorpera.native-result-fence/v1";
+    const MAX_FRAME_BYTES: usize = 8 * 1024 * 1024;
+    const MAX_SOURCE_BYTES: usize = 1024 * 1024;
+    const MAX_RESULT_BYTES: usize = 8 * 1024;
+    const DEADLINE: Duration = Duration::from_secs(5);
+
+    #[derive(Clone, Copy, Deserialize, PartialEq, Serialize)]
+    #[serde(rename_all = "snake_case")]
+    enum Kind {
+        FunctionCallOutput,
+        CustomToolCallOutput,
+    }
+
+    #[derive(Serialize)]
+    #[serde(rename_all = "camelCase")]
+    struct Output<'a> {
+        kind: Kind,
+        call_id: &'a str,
+        output: &'a FunctionCallOutputPayload,
+    }
+
+    #[derive(Serialize)]
+    #[serde(rename_all = "camelCase")]
+    struct Request<'a> {
+        schema: &'static str,
+        request_id: String,
+        thread_id: &'a str,
+        turn_id: Option<&'a str>,
+        purpose: &'static str,
+        outputs: Vec<Output<'a>>,
+    }
+
+    #[derive(Deserialize)]
+    #[serde(rename_all = "camelCase", deny_unknown_fields)]
+    struct Reply {
+        schema: String,
+        request_id: String,
+        thread_id: String,
+        turn_id: Option<String>,
+        outputs: Vec<FencedOutput>,
+    }
+
+    #[derive(Deserialize)]
+    #[serde(rename_all = "camelCase", deny_unknown_fields)]
+    struct FencedOutput {
+        kind: Kind,
+        call_id: String,
+        output: String,
+    }
+
+    pub(super) async fn fence(
+        input: &mut [ResponseItem],
+        metadata: &CodexResponsesMetadata,
+        socket: &Path,
+    ) -> std::result::Result<(), ()> {
+        if !socket.is_absolute() {
+            return Err(());
+        }
+        let mut outputs = Vec::new();
+        let mut indexes = Vec::new();
+        let mut source_bytes = 0;
+        for (index, item) in input.iter().enumerate() {
+            let (kind, call_id, output) = match item {
+                ResponseItem::FunctionCallOutput {
+                    call_id, output, ..
+                } => (Kind::FunctionCallOutput, call_id, output),
+                ResponseItem::CustomToolCallOutput {
+                    call_id, output, ..
+                } => (Kind::CustomToolCallOutput, call_id, output),
+                // These surfaces are not admitted by this cloud adapter. Never silently
+                // pass an unhandled result or a newly introduced item to the provider.
+                ResponseItem::AgentMessage { .. }
+                | ResponseItem::LocalShellCall { .. }
+                | ResponseItem::ToolSearchCall { .. }
+                | ResponseItem::ToolSearchOutput { .. }
+                | ResponseItem::WebSearchCall { .. }
+                | ResponseItem::ImageGenerationCall { .. }
+                | ResponseItem::Other => return Err(()),
+                ResponseItem::AdditionalTools { .. }
+                | ResponseItem::Message { .. }
+                | ResponseItem::Reasoning { .. }
+                | ResponseItem::FunctionCall { .. }
+                | ResponseItem::CustomToolCall { .. }
+                | ResponseItem::Compaction { .. }
+                | ResponseItem::CompactionTrigger { .. }
+                | ResponseItem::ContextCompaction { .. } => continue,
+            };
+            if call_id.is_empty() || call_id.len() > 160 || outputs.len() >= 128 {
+                return Err(());
+            }
+            match &output.body {
+                FunctionCallOutputBody::Text(text) => source_bytes += text.len(),
+                FunctionCallOutputBody::ContentItems(items) => {
+                    if items.len() > 16 {
+                        return Err(());
+                    }
+                    for item in items {
+                        match item {
+                            FunctionCallOutputContentItem::InputText { text } => {
+                                source_bytes += text.len();
+                            }
+                            FunctionCallOutputContentItem::InputImage { .. }
+                            | FunctionCallOutputContentItem::InputAudio { .. }
+                            | FunctionCallOutputContentItem::EncryptedContent { .. } => {
+                                return Err(());
+                            }
+                        }
+                    }
+                }
+            }
+            if source_bytes > MAX_SOURCE_BYTES {
+                return Err(());
+            }
+            indexes.push(index);
+            outputs.push(Output {
+                kind,
+                call_id,
+                output,
+            });
+        }
+        let purpose = match metadata.request_kind {
+            Some(CodexResponsesRequestKind::Prewarm) => "prewarm",
+            Some(CodexResponsesRequestKind::Compaction(_)) => "compaction",
+            Some(CodexResponsesRequestKind::Memory) => return Err(()),
+            Some(CodexResponsesRequestKind::Turn) | None => "turn",
+        };
+        let request = Request {
+            schema: SCHEMA,
+            request_id: Uuid::new_v4().to_string(),
+            thread_id: &metadata.thread_id,
+            turn_id: metadata.turn_id.as_deref(),
+            purpose,
+            outputs,
+        };
+        let wire = serde_json::to_vec(&request).map_err(|_| ())?;
+        if wire.len() > MAX_FRAME_BYTES {
+            return Err(());
+        }
+        // Even an empty first request requires a live host acknowledgement. This is
+        // outside the provider HTTP/WS layer and never forwards its authorization.
+        let reply: Reply = tokio::time::timeout(DEADLINE, async {
+            let mut stream = UnixStream::connect(socket).await.map_err(|_| ())?;
+            stream.write_u32(wire.len() as u32).await.map_err(|_| ())?;
+            stream.write_all(&wire).await.map_err(|_| ())?;
+            let size = stream.read_u32().await.map_err(|_| ())? as usize;
+            if size == 0 || size > MAX_FRAME_BYTES {
+                return Err(());
+            }
+            let mut bytes = vec![0; size];
+            stream.read_exact(&mut bytes).await.map_err(|_| ())?;
+            serde_json::from_slice(&bytes).map_err(|_| ())
+        })
+        .await
+        .map_err(|_| ())??;
+        if reply.schema != SCHEMA
+            || reply.request_id != request.request_id
+            || reply.thread_id != request.thread_id
+            || reply.turn_id.as_deref() != request.turn_id
+            || reply.outputs.len() != request.outputs.len()
+        {
+            return Err(());
+        }
+        // Validate the whole batch before replacing any body. Names, calls, roles,
+        // instructions, model settings and credentials cannot be rewritten here.
+        for (fenced, original) in reply.outputs.iter().zip(&request.outputs) {
+            if fenced.kind != original.kind
+                || fenced.call_id != original.call_id
+                || fenced.output.len() > MAX_RESULT_BYTES
+            {
+                return Err(());
+            }
+            let envelope: serde_json::Value =
+                serde_json::from_str(&fenced.output).map_err(|_| ())?;
+            if envelope["schema"] != "qorpera.cloud-tool-result/v1"
+                || envelope["trust"] != "untrusted_data"
+                || envelope["provenance"]["callId"] != fenced.call_id
+            {
+                return Err(());
+            }
+        }
+        for (fenced, index) in reply.outputs.into_iter().zip(indexes) {
+            if let ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } = &mut input[index]
+            {
+                output.body = FunctionCallOutputBody::Text(fenced.output);
+            }
+        }
+        Ok(())
+    }
+}
+
