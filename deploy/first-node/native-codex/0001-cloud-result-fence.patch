+                    .as_array_mut()
+                    .unwrap()
+                    .push(json!({"type":"input_text","text":"extra"}));
+            }
+            "text" => value[0]["output"][0]["text"] = json!("x".repeat(8193)),
+            _ => panic!("unknown capture fault"),
+        }
+        let mut input: Vec<ResponseItem> = serde_json::from_value(value).unwrap();
+        let original = input.clone();
+        // A listening socket with no accepting host distinguishes rejection
+        // from a connection error: malformed content must not wait for timeout.
+        let listener = UnixListener::bind(&path).unwrap();
+        assert_eq!(
+            tokio::time::timeout(
+                std::time::Duration::from_secs(1),
+                fence(&mut input, &metadata(), &path)
+            )
+            .await
+            .unwrap(),
+            Err(()),
+            "{fault}"
+        );
+        assert_eq!(input, original, "{fault}");
+        drop(listener);
+        std::fs::remove_file(&path).unwrap();
+    }
+}
