[Unit]
Description=Qorpera durable Runner Orchestrator
Documentation=https://github.com/Qorpera/Qorpera_Base
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/qorpera/runner-orchestrator.env

[Service]
Type=exec
User=qorpera-orchestrator
Group=qorpera-orchestrator
EnvironmentFile=-/etc/qorpera/runner-orchestrator.env
ExecStart=/usr/bin/node --jitless /opt/qorpera/runner-orchestrator/qorpera-runner-orchestrator.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/qorpera-orchestrator

[Install]
WantedBy=multi-user.target
