QORPERA_RUNNER_PROVIDER_BACKEND=lxd-company-computer
QORPERA_RUNNER_PROVIDER_ADAPTER=lxd-company-computer
QORPERA_RUNNER_PROVIDER_TOKEN=REPLACE_WITH_ORCHESTRATOR_TO_PROVIDER_CAPABILITY
QORPERA_RUNNER_PROVIDER_HOST=127.0.0.1
QORPERA_RUNNER_PROVIDER_PORT=8084
QORPERA_RUNNER_PROVIDER_RECONCILE_SECONDS=60

QORPERA_LXD_NODE_KEY=company41-node-01
QORPERA_SUPABASE_URL=https://REPLACE.supabase.co
QORPERA_SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVICE_ROLE_SECRET
QORPERA_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY

QORPERA_RUNNER_PROVIDER_STATE_ROOT=/var/lib/qorpera-company-provider
QORPERA_LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket
QORPERA_LXD_OPERATION_TIMEOUT_SECONDS=180
QORPERA_LXD_PROJECT=qorpera-runners
QORPERA_LXD_COMPUTER_PROFILE=qorpera-company-computer-v1
QORPERA_LXD_NETWORK_INTERFACE=enp5s0
QORPERA_LXD_IMAGE_SERVER=local
QORPERA_LXD_IMAGE_FINGERPRINT=REPLACE_AFTER_IMAGE_SIGNING
QORPERA_LXD_GUEST_PACKAGE_MANIFEST_SHA256=REPLACE_WITH_64_HEX_GUEST_PACKAGE_MANIFEST_DIGEST
QORPERA_LXD_IMAGE_PROVENANCE=/etc/qorpera/lxd-company-image-provenance.json
QORPERA_LXD_IMAGE_PROVENANCE_PUBLIC_KEY=/etc/qorpera/lxd-image-provenance.pub
QORPERA_LXD_STORAGE_POOL=qorpera-vm
QORPERA_LXD_IDENTITY_VOLUME_PREFIX=qorpera-identity-
QORPERA_LXD_IDENTITY_VOLUME_SIZE=8GiB
QORPERA_LXD_ROOT_DISK_SIZE=80GiB
QORPERA_LXD_CPU_LIMIT=8
QORPERA_LXD_MEMORY_LIMIT=16GiB
# Service startup requires this path to be a mountpoint; every VM
# create/recovery additionally proves read-write NFS and dataset presence.
QORPERA_LXD_NAS_DATASET_ROOT=/mnt/qorpera-companies
QORPERA_LXD_NAS_SHARED_GID=100
QORPERA_LXD_GUEST_ASSIGNMENT_PORT=8444
QORPERA_LXD_GUEST_ASSIGNMENT_SOURCE=10.41.0.1
QORPERA_LXD_NATIVE_BRIDGE_PORT=8445
QORPERA_LXD_NATIVE_EXECUTION_GID=42041
QORPERA_LXD_GUEST_READY_TIMEOUT_MS=300000
QORPERA_LXD_GUEST_SCREEN_VIEWER_PORT=8446
QORPERA_LXD_DATASET_SNAPSHOT_INTERVAL_SECONDS=21600
# Optional deployment hook. Automatic rollback snapshots remain disabled
# until this command is configured against the NAS snapshot API/tooling.
# QORPERA_LXD_DATASET_SNAPSHOT_COMMAND=["/usr/local/sbin/qorpera-nas-snapshot","{dataset}","{snapshot}"]
QORPERA_LXD_SCREEN_POLL_SECONDS=30
QORPERA_LXD_IDLE_POWER_OFF_SECONDS=300

QORPERA_EPHEMERAL_RUNNER_IMAGE=REPLACE_WITH_DIGEST_PINNED_RUNNER_IMAGE
QORPERA_EPHEMERAL_RUNNER_IMAGE_ARCHIVE_SHA256=REPLACE_WITH_64_HEX_ARCHIVE_DIGEST
QORPERA_EPHEMERAL_RUNNER_IMAGE_COSIGN_BUNDLE_SHA256=REPLACE_WITH_64_HEX_BUNDLE_DIGEST
QORPERA_EPHEMERAL_RUNNER_PODMAN=/usr/bin/podman
QORPERA_EPHEMERAL_RUNNER_ENTRYPOINT=/qorpera/bin/run-job
QORPERA_EPHEMERAL_RUNNER_VERSION=v34

QORPERA_LXD_SCREEN_VIEWER_GATEWAY_HOST=0.0.0.0
QORPERA_LXD_SCREEN_VIEWER_GATEWAY_PORT=18446
