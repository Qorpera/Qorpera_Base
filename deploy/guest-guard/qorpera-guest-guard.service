[Unit]
Description=Qorpera guest guard (machines on our LXD bridges never reach the NAS, the office network, the nodes or Tailscale)
Documentation=https://github.com/Qorpera/Qorpera_Base/blob/master/deploy/guest-guard/README.md
# Loaded before LXD starts any guest. The mode file says observe or enforce; without it the unit does nothing.
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target snap.lxd.daemon.service
Wants=network-pre.target
ConditionPathExists=/etc/qorpera-guest-guard/mode

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/qorpera-guest-guard/qorpera-guest-guard.sh boot
# Stopping the unit is the undo: the table is deleted.
ExecStop=/usr/local/libexec/qorpera-guest-guard/qorpera-guest-guard.sh remove

[Install]
WantedBy=multi-user.target
