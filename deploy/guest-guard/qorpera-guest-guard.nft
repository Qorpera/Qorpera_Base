# Qorpera guest guard (E-1). Machines on our LXD bridges reach the internet, their bridge's DNS and DHCP,
# and the short list of our own services below. They never reach the NAS, the office network, the nodes'
# other ports, Tailscale or link-local addresses. Only connections a guest starts are checked: replies,
# and connections the node itself opens to a guest, pass untouched.
#
# Load it with qorpera-guest-guard.sh, never with `nft -f` alone: the script picks the mode (observe or
# enforce) and replaces the table in one transaction. The same file runs on every node. See README.md.

table inet qorpera_guest_guard {
	# Bridges whose machines are guests. A name that does not exist on a node matches nothing.
	set guest_bridges {
		type ifname
		elements = { "qorpera0", "coding-net", "qofficebuild0", "pr146build0", "testmach0", "machine-net" }
	}

	# Each bridge's own address, for its own guests' DNS (53) and ping only. DHCP (67) is allowed on every
	# guest bridge, broadcast included.
	set bridge_gateways {
		type ifname . ipv4_addr
		elements = {
			"qorpera0" . 10.41.0.1, "coding-net" . 10.200.0.1, "qofficebuild0" . 10.203.0.1,
			"pr146build0" . 10.133.254.1, "testmach0" . 10.201.0.1, "machine-net" . 10.88.0.1
		}
	}

	# Never reached through a node unless listed in allowed_services: private, shared (Tailscale),
	# loopback, link-local and special ranges, and our own public address.
	set internal4 {
		type ipv4_addr
		flags interval
		elements = {
			0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
			192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4, 93.164.62.162
		}
	}

	# Our own services that guests call, per bridge. README.md, "What guests need", has the evidence.
	set allowed_services {
		type ifname . ipv4_addr . inet_proto . inet_service
		elements = {
			"qorpera0" . 10.41.0.1 . tcp . 8789,
			"qorpera0" . 100.75.4.70 . tcp . 443,
			"qorpera0" . 100.75.4.70 . tcp . 8443,
			"qorpera0" . 100.75.4.70 . tcp . 8444,
			"qorpera0" . 100.75.4.70 . tcp . 10000,
			"qorpera0" . 100.75.4.70 . tcp . 18443,
			"qorpera0" . 100.75.4.70 . tcp . 18444,
			"qorpera0" . 100.75.4.70 . tcp . 18543,
			"qorpera0" . 100.75.4.70 . tcp . 18544,
			"qorpera0" . 100.80.160.64 . tcp . 10000
		}
	}

	counter allowed_services_used {
	}

	counter refused_forward {
	}

	counter refused_input {
	}

	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname @guest_bridges ct state new jump guest_forward
	}

	chain input {
		type filter hook input priority filter - 10; policy accept;
		iifname @guest_bridges ct state new jump guest_input
	}

	# A guest's connection through the node: the internet passes, our own networks only as listed.
	chain guest_forward {
		meta nfproto ipv6 goto refuse_forward
		ip daddr != @internal4 return
		iifname . ip daddr . meta l4proto . th dport @allowed_services counter name "allowed_services_used" return
		goto refuse_forward
	}

	# A guest's connection to the node itself, on any of its addresses.
	chain guest_input {
		meta nfproto ipv6 goto refuse_input
		udp dport 67 return
		iifname . ip daddr @bridge_gateways udp dport 53 return
		iifname . ip daddr @bridge_gateways tcp dport 53 return
		iifname . ip daddr @bridge_gateways icmp type echo-request return
		iifname . ip daddr . meta l4proto . th dport @allowed_services counter name "allowed_services_used" return
		goto refuse_input
	}

	# Observe mode stops here: count and log. Enforce mode appends the rejects (qorpera-guest-guard.sh).
	chain refuse_forward {
		counter name "refused_forward"
		limit rate 30/minute burst 60 packets log prefix "qorpera-guest-guard forward: " level info
	}

	chain refuse_input {
		counter name "refused_input"
		limit rate 30/minute burst 60 packets log prefix "qorpera-guest-guard input: " level info
	}
}
