[Unit]
Description=Qorpera agent exit: the agent plug's reconciler (client map, leases, quarantine, flushes)
Documentation=https://github.com/Qorpera/Qorpera_Base/blob/master/deploy/first-node/RUNTIME-AGENT-EXIT.md
After=qorpera-agent-exit.service snap.lxd.daemon.service
ConditionPathExists=/run/netns/qexit

[Service]
ExecStart=/usr/local/libexec/qorpera-agent-exit/qorpera-agent-exit.sh plug
Restart=always
RestartSec=2

[Install]
WantedBy=qorpera-agent-exit.service
