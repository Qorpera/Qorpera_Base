# Qorpera agent exit (E1): the rules inside the exit's own network namespace, qexit. Agent machines on the bridge
# qagent0 reach the exit's br0 (10.210.0.1/16); the exit sends their traffic out of up0 from its own address.
# It refuses our own networks and outbound mail servers (TCP 25), drops IPv6, counts every new connection and
# refusal per client, and answers names and DHCP itself (dnsmasq on 10.210.0.1). Plain DNS a machine sends
# elsewhere is redirected to it.
#
# Load it with qorpera-agent-exit.sh, never with `nft -f` alone. The same file runs on every node. See README.md and
# deploy/first-node/RUNTIME-AGENT-EXIT.md.

table inet qorpera_agent_exit {
	# Never reached from an agent machine: private, shared (Tailscale), loopback, link-local and special ranges, and
	# our own public address. The agent addresses join this set when the address block is in use (E9).
	set internal4 {
		type ipv4_addr
		flags interval
		elements = {
			0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
			192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4, 93.164.62.162
		}
	}

	# Per client address: new connections, and refused ones with why (the line guard's counts, E7).
	set new_by_client {
		type ipv4_addr
		flags dynamic
		size 65536
	}

	# A refused flow, kept for an hour so the logger can write it once (refusals never reach conntrack's log).
	set refused_flows {
		type ipv4_addr . ipv4_addr . inet_proto . inet_service
		flags dynamic, timeout
		timeout 1h
		size 65536
	}

	counter refused_internal {
	}

	counter refused_mail {
	}

	counter refused_spoofed {
	}

	counter dropped_ipv6 {
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "br0" ip daddr != 10.210.0.1 udp dport 53 dnat ip to 10.210.0.1
		iifname "br0" ip daddr != 10.210.0.1 tcp dport 53 dnat ip to 10.210.0.1
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		iifname "br0" oifname "up0" jump agent_out
	}

	chain agent_out {
		meta nfproto ipv6 counter name "dropped_ipv6" drop
		ip saddr != 10.210.0.0/16 counter name "refused_spoofed" drop
		ct state invalid drop
		update @new_by_client { ip saddr counter }
		ip daddr @internal4 counter name "refused_internal" goto refuse
		tcp dport 25 counter name "refused_mail" goto refuse
		accept
	}

	chain refuse {
		update @refused_flows { ip saddr . ip daddr . meta l4proto . th dport }
		meta l4proto tcp reject with tcp reset
		reject with icmpx admin-prohibited
	}

	# The exit itself answers agent machines' DHCP, DNS and ping, and nothing else.
	chain input {
		type filter hook input priority filter; policy drop;
		iifname "lo" accept
		ct state established,related accept
		iifname "br0" udp sport 68 udp dport 67 accept
		iifname "br0" ip daddr 10.210.0.1 udp dport 53 accept
		iifname "br0" ip daddr 10.210.0.1 tcp dport 53 accept
		iifname "br0" ip daddr 10.210.0.1 icmp type echo-request accept
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "up0" masquerade
	}
}
