# Qorpera agent exit (E1): the rules inside the exit's own network namespace, qexit. Agent road machines on the
# bridge qagent0 reach the exit's br0 (10.210.0.1/16); the exit sends their traffic out of up0 from its own address.
# It refuses our own networks and TCP port 25 at once, drops IPv6, foreign sources and invalid packets, bounds each
# machine to 16,384 open connections and the exit to 98,304 (decided 3 October), holds a closed agent connection 30
# seconds instead of the kernel's 120 (the bounds do not count closed ones), counts new connections and refusals per
# machine, keeps each refused flow an hour for the log, and answers names and DHCP itself (dnsmasq on 10.210.0.1).
# A machine's plain DNS, to any address, goes to its company's resolver (E8b: the dns_port map, which the names
# reconciler keeps); a machine without an element there gets no DNS at all. The brake (E7) slows the new connections of
# a company the line guard put in the braked map; it is off until the founder sets its levels, and never touches open
# connections.
#
# Load it with qorpera-agent-exit.sh, never with `nft -f` alone. The same file runs on every node. See README.md and
# deploy/first-node/RUNTIME-AGENT-EXIT.md.

table inet qorpera_agent_exit {
	# Never reached from an agent road machine: private, shared (Tailscale), loopback, link-local and special ranges,
	# and our own public address. The agent addresses join this set when the address block is in use (E9).
	set internal4 {
		type ipv4_addr
		flags interval
		elements = {
			0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
			192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4, 93.164.62.162
		}
	}

	# Per machine: new connections and refusals, counted.
	set new_by_client {
		type ipv4_addr
		flags dynamic
		size 65536
	}

	set refused_by_client {
		type ipv4_addr
		flags dynamic
		size 65536
	}

	# Per machine: open connections, bounded at 16,384 (contract item 4; an infrastructure guard for the node).
	set open_by_client {
		type ipv4_addr
		flags dynamic
		size 65536
	}

	# Per machine: how fast it may add refused flows to the log sets, so one machine cannot crowd out the others.
	set refusal_rate {
		type ipv4_addr
		flags dynamic, timeout
		timeout 1h
		size 65536
	}

	# A refused flow, added once and kept an hour, so the logger writes it once an hour (refusals never reach
	# conntrack's events). TCP and UDP per port, other protocols per protocol; each with the mark the packet was refused
	# with, so the logger reads which rule refused it as it was then (0x80000003 the machine's rules not known,
	# 0x80000004 not listed, none for our networks, mail and the open bounds).
	set refused_flows {
		type ipv4_addr . ipv4_addr . inet_proto . inet_service . mark
		flags dynamic, timeout
		timeout 1h
		size 65536
	}

	set refused_other {
		type ipv4_addr . ipv4_addr . inet_proto . mark
		flags dynamic, timeout
		timeout 1h
		size 16384
	}

	# The brake (E7). The line guard in the connection logger fills braked: each machine of a braked company, with the
	# company's number, until its brake ends (the element's timeout, so a brake ends also without the guard); a reload
	# empties it and the guard fills it again within seconds. A company's number keys its share in slowed, its count of
	# the new connections the brake dropped in dropped, and of those let through later on a resend in resent. tried
	# holds each dropped flow 3 minutes (a machine resends a first packet for about 2), so it counts once.
	map braked {
		type ipv4_addr : mark
		flags timeout
		size 65536
	}

	set slowed {
		type mark
		flags dynamic, timeout
		timeout 1m
		size 65536
	}

	set dropped {
		type mark
		flags dynamic, timeout
		timeout 1h
		size 65536
	}

	set resent {
		type mark
		flags dynamic, timeout
		timeout 1h
		size 65536
	}

	set tried {
		type ipv4_addr . ipv4_addr . inet_proto . inet_service . inet_service
		flags dynamic, timeout
		timeout 3m
		size 65536
	}

	# Each company's names (E8b): every verified machine's resolver port on 10.210.0.1, 53 (the main dnsmasq) for a
	# company without rules or its company's own resolver; dns_allowed lets exactly that pair in. The names reconciler
	# (qorpera-agent-exit-names.py) keeps both; the agent plug clears a machine's elements when it unplugs it. A machine
	# with no element (company not known yet, rules not usable, no resolver port) has its DNS dropped.
	map dns_port {
		type ipv4_addr : inet_service
		size 65536
	}

	set dns_allowed {
		type ipv4_addr . inet_service
		size 65536
	}

	# Where each verified machine may go (E8c): `goto open` for a company without rules or with "open" rules, `goto
	# only_P` for a company in "only listed" mode whose resolver listens on port P. The names reconciler keeps it, with
	# each only_P chain and its allow_P set (the addresses that company's resolver gave out for listed names); the agent
	# plug clears a machine's element when it unplugs it. A machine with no element (company not known yet, rules not
	# usable) is refused.
	map reach {
		type ipv4_addr : verdict
		size 65536
	}

	counter refused_dns {
	}

	counter refused_internal {
	}

	counter refused_mail {
	}

	counter refused_open_limit {
	}

	counter refused_rules_unknown {
	}

	counter refused_not_listed {
	}

	counter refused_unlogged {
	}

	counter refused_spoofed {
	}

	counter dropped_ipv6 {
	}

	counter dropped_invalid {
	}

	counter dropped_braked {
	}

	# Agent TCP connections: a closed one (TIME_WAIT) is kept 30 seconds, not the kernel's 120. The open-connection
	# bounds do not count closed connections, so a machine that opens and closes fast would otherwise hold tens of
	# thousands of entries, and the exit's shared source ports towards a site with them. Other states keep the
	# defaults.
	ct timeout agent_tcp {
		protocol tcp
		l3proto ip
		policy = { time_wait : 30 }
	}

	chain timeouts {
		type filter hook prerouting priority filter; policy accept;
		iifname "br0" ip saddr 10.210.0.0/16 meta l4proto tcp ct state new ct timeout set "agent_tcp"
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		# A machine without an element is not redirected: forward and input drop its DNS.
		iifname "br0" ip saddr 10.210.0.0/16 meta l4proto { tcp, udp } th dport 53 dnat ip to 10.210.0.1 : ip saddr map @dns_port
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		# DNS never leaves past the exit's resolvers (a machine the map does not redirect).
		iifname "br0" meta l4proto { tcp, udp } th dport 53 counter name "refused_dns" drop
		iifname "br0" oifname "up0" jump agent_out
	}

	chain agent_out {
		meta nfproto ipv6 counter name "dropped_ipv6" drop
		ip saddr != 10.210.0.0/16 counter name "refused_spoofed" drop
		ct state invalid counter name "dropped_invalid" drop
		update @new_by_client { ip saddr counter }
		ip daddr @internal4 counter name "refused_internal" goto refuse
		tcp dport 25 counter name "refused_mail" goto refuse
		ip saddr vmap @reach
		meta mark set 0x80000003 counter name "refused_rules_unknown" goto refuse
	}

	# A flow its company's rules let out. The only_P chains (one per company in "only listed" mode, kept by the names
	# reconciler) come here too: `tcp dport 443 ip daddr @allow_P goto open`, then `meta mark set 0x80000004 counter name
	# "refused_not_listed" goto refuse`.
	chain open {
		# The per-machine bound first: a machine at its own bound never reaches the shared total's list.
		add @open_by_client { ip saddr ct count over 16384 } counter name "refused_open_limit" goto refuse
		ct count over 98304 counter name "refused_open_limit" goto refuse
		jump brake
		accept
	}

	# The brake (E7): a braked company's machines get its number as their mark, and go through its share. Only a
	# connection's first packet: a resent one of a connection let through is confirmed already, and passes.
	chain brake {
		ct status confirmed return
		meta mark set ip saddr map @braked goto slow
	}

	# Under its share a new connection goes on (and is let through); past it, it is dropped and the machine tries again a
	# little later, as on any busy line. One let through after it was dropped is counted in resent.
	chain slow {
		jump share
		meta l4proto { tcp, udp } ip saddr . ip daddr . meta l4proto . th sport . th dport @tried update @resent { meta mark counter }
	}

	# The line guard writes one rule here while the brake is on, with the founder's share S (new connections per 10
	# seconds): `update @slowed { meta mark limit rate over 6S/minute burst S packets } goto braked_drop comment
	# "slow S"`.
	chain share {
	}

	# A dropped connection counts once in dropped, however often its machine resends the first packet.
	chain braked_drop {
		counter name "dropped_braked"
		meta l4proto { tcp, udp } ip saddr . ip daddr . meta l4proto . th sport . th dport @tried drop
		meta l4proto { tcp, udp } add @tried { ip saddr . ip daddr . meta l4proto . th sport . th dport }
		update @dropped { meta mark counter }
		drop
	}

	chain refuse {
		update @refused_by_client { ip saddr counter }
		# Only a flow not yet kept spends the machine's share; one that still is not kept (share spent, set full) is
		# counted as unlogged, and the logger turns that count into a gap line.
		meta l4proto { tcp, udp } ip saddr . ip daddr . meta l4proto . th dport . meta mark != @refused_flows update @refusal_rate { ip saddr limit rate 600/hour burst 100 packets } add @refused_flows { ip saddr . ip daddr . meta l4proto . th dport . meta mark }
		meta l4proto { tcp, udp } ip saddr . ip daddr . meta l4proto . th dport . meta mark != @refused_flows counter name "refused_unlogged"
		meta l4proto != { tcp, udp } ip saddr . ip daddr . meta l4proto . meta mark != @refused_other update @refusal_rate { ip saddr limit rate 600/hour burst 100 packets } add @refused_other { ip saddr . ip daddr . meta l4proto . meta mark }
		meta l4proto != { tcp, udp } ip saddr . ip daddr . meta l4proto . meta mark != @refused_other counter name "refused_unlogged"
		meta l4proto tcp reject with tcp reset
		reject with icmpx admin-prohibited
	}

	# The exit itself answers agent road machines' DHCP, DNS and ping, and nothing else.
	chain input {
		type filter hook input priority filter; policy drop;
		iifname "lo" accept
		ct state established,related accept
		iifname "br0" ip saddr { 0.0.0.0, 10.210.0.0/16 } udp sport 68 udp dport 67 accept
		# DNS only to the machine's own resolver (the map redirected it there); not to another company's port.
		iifname "br0" ip saddr 10.210.0.0/16 ip daddr 10.210.0.1 meta l4proto { tcp, udp } ip saddr . th dport @dns_allowed accept
		iifname "br0" meta l4proto { tcp, udp } th dport 53 counter name "refused_dns" drop
		iifname "br0" ip saddr 10.210.0.0/16 ip daddr 10.210.0.1 icmp type echo-request accept
	}

	# The exit's own answers (DNS, DHCP, the companies' resolvers) never leave by the uplink, so a forged source cannot
	# bounce them outward. The resolvers ask upstream from up0's own address.
	chain output {
		type filter hook output priority filter; policy accept;
		oifname "up0" udp sport { 53, 67 } drop
		oifname "up0" tcp sport 53 drop
		oifname "up0" ip saddr 10.210.0.1 drop
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "up0" masquerade
	}
}
