[Unit]
Description=Qorpera agent exit: DHCP and DNS for agent road machines (dnsmasq in the exit's namespace)
Documentation=https://github.com/Qorpera/Qorpera_Base/blob/master/deploy/first-node/RUNTIME-AGENT-EXIT.md
After=qorpera-agent-exit.service
# At shutdown LXD stops the machines first, so they lose names and the log only after they are gone.
Before=snap.lxd.daemon.service
ConditionPathExists=/run/netns/qexit

[Service]
NetworkNamespacePath=/run/netns/qexit
ExecStart=/usr/local/libexec/qorpera-agent-exit/qorpera-agent-exit.sh dns
# The agent plug (E2) reloads after removing a machine's lease file.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# dnsmasq parses what agent road machines send: keep it to what it needs.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/qorpera-agent-exit /var/log/qorpera-agent-exit
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX AF_PACKET
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_CHOWN

[Install]
WantedBy=qorpera-agent-exit.service
