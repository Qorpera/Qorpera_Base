[Unit]
Description=Qorpera agent exit: connection log (conntrack events and refused flows, never content)
Documentation=https://github.com/Qorpera/Qorpera_Base/blob/master/deploy/first-node/RUNTIME-AGENT-EXIT.md
After=qorpera-agent-exit.service
ConditionPathExists=/run/netns/qexit

[Service]
ExecStart=/usr/local/libexec/qorpera-agent-exit/qorpera-agent-exit.sh log
Restart=always
RestartSec=2

[Install]
WantedBy=qorpera-agent-exit.service
