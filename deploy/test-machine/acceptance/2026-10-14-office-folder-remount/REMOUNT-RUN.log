  "mountUnit": [
    "[Unit]",
    "Description=Qorpera company folder %i (from this node's folder service; read-write only for a view it lets write)",
    "ConditionPathExists=/run/qorpera-folder/views/%i.json",
    "",
    "[Service]",
    "Type=exec",
    "# Only root can enter /srv/qorpera-folder, and the mount serves only the account that made it (no allow_other).",
    "# A writable view's version map is kept in /run/qorpera-folder/<view id>/ (memory, root's only): it outlives the",
    "# program, so a mount started again bases saves on what was read before, and goes when the machine restarts.",
    "ExecStart=/var/lib/qorpera-remount-f1287d81-5688-4f6a-90bf-e2f542d06fb8/qorpera-folder mount --connect unix:/run/qorpera-remount-f1287d81-5688-4f6a-90bf-e2f542d06fb8/node.sock --view-file /run/qorpera-folder/views/%i.json --mountpoint /run/qorpera-folder/mounts/%i/company --state-dir /run/qorpera-folder/state/%i --allow-other yes --owner-uid 20045 --owner-gid 20045",
    "# A program killed hard leaves its mount behind; take it away.",
    "ExecStopPost=-/usr/bin/umount -l /run/qorpera-folder/mounts/%i/company",
    "Restart=on-failure",
    "RestartSec=5s",
    "# 3: the node closed or refused the view. Starting again would only be refused again.",
    "RestartPreventExitStatus=3",
    "KillMode=mixed",
    "TimeoutStopSec=20s",
    "LimitCORE=0",
    "# The mount must appear in PID 1's mount namespace, so no option here makes a namespace of its own (ProtectSystem,",
    "# PrivateTmp, PrivateDevices, ProtectHome, ReadWritePaths, ProtectKernel*, ProtectControlGroups).",
    "NoNewPrivileges=yes",
    "CapabilityBoundingSet=CAP_SYS_ADMIN",
    "DevicePolicy=closed",
    "DeviceAllow=/dev/fuse rw",
    "RestrictAddressFamilies=AF_UNIX AF_VSOCK",
    "RestrictSUIDSGID=yes",
    "RestrictRealtime=yes",
    "LockPersonality=yes",
    "MemoryDenyWriteExecute=yes",
    "SystemCallArchitectures=native",
    "MemoryMax=512M",
    "MemorySwapMax=0",
    ""
  ],
