[Unit]
Description=Qorpera ephemeral runner inside an LXD full VM
Documentation=https://github.com/Qorpera/Qorpera_Base
Wants=network-online.target
Requires=qorpera-native-provider-host.service
After=network-online.target qorpera-native-provider-host.service
RequiresMountsFor=/var/lib/qorpera/identity

[Service]
Type=exec
User=qorpera-runner
Group=qorpera-runner
SupplementaryGroups=qorpera-native-execution
WorkingDirectory=/var/lib/qorpera-runner
Environment=HOME=/var/lib/qorpera-runner
Environment=XDG_RUNTIME_DIR=/run/qorpera-runner
Environment=QORPERA_RUNNER_CONFIG=/var/lib/qorpera-runner/.config/qorpera-runner/config.json
# The live company tree arrives squash-owned by one NAS uid; git must trust
# it or every company transaction fails as an invalid repository.
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0=*
RuntimeDirectory=qorpera-runner
RuntimeDirectoryMode=0700
LoadCredential=qorpera-runner-activation:/var/lib/qorpera-bootstrap/credentials/qorpera-runner-activation
LoadCredential=qorpera-runner-assignment:/var/lib/qorpera-bootstrap/credentials/qorpera-runner-assignment
LoadCredential=qorpera-native-bridge:/var/lib/qorpera-bootstrap/credentials/qorpera-native-bridge
ExecStart=/usr/bin/node /opt/qorpera-runner/qorpera-ephemeral-runner.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
Delegate=yes
PrivateTmp=yes
ProtectSystem=strict
# The optional live Company File device is writable by contract. Without this
# allowlist entry ProtectSystem=strict remounts it read-only in the service.
ReadWritePaths=/var/lib/qorpera-runner /var/lib/qorpera-native-workspace /run/qorpera-runner /qorpera/company-live
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=no
LockPersonality=yes

[Install]
WantedBy=multi-user.target
