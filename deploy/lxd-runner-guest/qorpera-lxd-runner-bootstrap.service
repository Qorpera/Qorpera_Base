[Unit]
Description=Qorpera LXD runner guest bootstrap
Documentation=https://github.com/Qorpera/Qorpera_Base
Wants=network-online.target
After=local-fs.target network-online.target
ConditionPathExists=/var/lib/qorpera-bootstrap/bootstrap.json
ConditionPathExists=/var/lib/qorpera-bootstrap/runner-config.json
# No mount condition on /var/lib/qorpera/identity: a guest whose login the vault keeps has no
# identity volume. The bootstrap itself requires the mount for a node login and refuses it for
# a vault login (Stateless Compute step 1).

[Service]
Type=oneshot
ExecStart=/usr/bin/node /opt/qorpera-runner/qorpera-lxd-runner-bootstrap.mjs
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/qorpera-bootstrap /var/lib/qorpera/identity /var/lib/qorpera-runner /var/lib/qorpera-native-provider /var/lib/qorpera-native-workspace
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER

[Install]
WantedBy=multi-user.target
