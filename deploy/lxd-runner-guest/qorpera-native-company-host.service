[Unit]
Description=Qorpera path-authorized native company runtime
Documentation=https://github.com/Qorpera/Qorpera_Base
Wants=network-online.target
After=network-online.target
Conflicts=qorpera-native-provider-host.service
RequiresMountsFor=/var/lib/qorpera/identity /var/lib/qorpera-runner

[Service]
Type=exec
User=qorpera-native-company
Group=qorpera-native-company
WorkingDirectory=/var/lib/qorpera-native-provider
Environment=HOME=/var/lib/qorpera-native-provider
EnvironmentFile=/var/lib/qorpera-bootstrap/native-provider.env
LoadCredential=qorpera-supabase-service-key:/var/lib/qorpera-bootstrap/credentials/qorpera-supabase-service-key
LoadCredential=qorpera-native-bridge:/var/lib/qorpera-bootstrap/credentials/qorpera-native-bridge
LoadCredential=qorpera-native-object-token:/var/lib/qorpera-bootstrap/credentials/qorpera-native-object-token
LoadCredential=qorpera-native-provider-master-key:/var/lib/qorpera/identity/qorpera-native-provider-master-key
ExecStart=/usr/bin/node /opt/qorpera-runner/qorpera-native-provider-host.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=control-group
KillSignal=SIGTERM
UMask=0077
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/qorpera-native-provider
# Credentials are supplied by PID 1; neither the source volumes nor the
# worker's private recovery state are available in this service namespace.
InaccessiblePaths=/var/lib/qorpera/identity /var/lib/qorpera-bootstrap /var/lib/qorpera-runner /var/lib/qorpera-native-workspace -/qorpera/company-live
ProtectHome=yes
ProtectProc=invisible
# The trusted launcher reads overflowuid/overflowgid when creating the user
# namespace. The native child receives a fresh procfs in its own PID namespace.
ProcSubset=all
ProtectHostname=private
ProtectClock=yes
# A masked parent procfs prevents unprivileged creation of the child's fresh
# procfs ("Mount too revealing"). Keep it readable only in this trusted host;
# its empty capabilities/non-root UID still deny kernel writes and log reads.
# The native child sees only the new PID namespace and no host filesystem.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=no
ProtectControlGroups=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Only the trusted launcher creates these; bubblewrap disables nested user
# namespaces before the native harness runs. No shared network or host proc.
RestrictNamespaces=user mnt pid net ipc uts cgroup
MemoryMax=2G
MemorySwapMax=0
TasksMax=256
CPUQuota=200%
# The launcher uses route netlink solely to bring up the new loopback device.
# The child has no capabilities and only its private network namespace.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
