[Unit]
Description=Qorpera native provider host inside an LXD full VM
Documentation=https://github.com/Qorpera/Qorpera_Base
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/qorpera/identity

[Service]
Type=exec
User=qorpera-native-provider
Group=qorpera-native-execution
# The live NAS export is squash-owned by GID 100 (users); the native harness
# must read and update files left by earlier ephemeral guest identities.
SupplementaryGroups=users
WorkingDirectory=/var/lib/qorpera-native-provider
Environment=HOME=/var/lib/qorpera-native-provider
# Same squash-ownership trust for git run by the provider harness.
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0=*
EnvironmentFile=/var/lib/qorpera-bootstrap/native-provider.env
LoadCredential=qorpera-native-bridge:/var/lib/qorpera-bootstrap/credentials/qorpera-native-bridge
LoadCredential=qorpera-native-identity:/var/lib/qorpera-bootstrap/credentials/qorpera-native-identity
LoadCredential=qorpera-native-provider-master-key:/var/lib/qorpera/identity/qorpera-native-provider-master-key
LoadCredential=qorpera-native-identity-epoch:/var/lib/qorpera-bootstrap/native-identity-epoch.json
ExecStart=/usr/bin/node /opt/qorpera-runner/qorpera-native-provider-host.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0007
PrivateTmp=yes
ProtectSystem=strict
# The official harness edits the optional live Company File through this
# service; ProtectSystem=strict must not remount that device read-only.
ReadWritePaths=/var/lib/qorpera-native-provider /var/lib/qorpera-native-workspace -/qorpera/company-live
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
