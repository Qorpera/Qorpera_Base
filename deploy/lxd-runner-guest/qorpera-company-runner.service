[Unit]
Description=Qorpera path-authorized cloud runner with retained recovery
Documentation=https://github.com/Qorpera/Qorpera_Base
Wants=network-online.target
Requires=qorpera-native-company-host.service
After=network-online.target qorpera-native-company-host.service
Conflicts=qorpera-ephemeral-runner.service
RequiresMountsFor=/var/lib/qorpera-runner
AssertPathIsMountPoint=/var/lib/qorpera-runner

[Service]
Type=exec
User=qorpera-company-runner
Group=qorpera-company-runner
WorkingDirectory=/var/lib/qorpera-runner
Environment=HOME=/var/lib/qorpera-runner
Environment=XDG_RUNTIME_DIR=/run/qorpera-runner
Environment=QORPERA_RUNNER_CONFIG=/var/lib/qorpera-runner/.config/qorpera-runner/config.json
RuntimeDirectory=qorpera-runner
RuntimeDirectoryMode=0700
LoadCredential=qorpera-runner-activation:/var/lib/qorpera-bootstrap/credentials/qorpera-runner-activation
LoadCredential=qorpera-runner-assignment:/var/lib/qorpera-bootstrap/credentials/qorpera-runner-assignment
LoadCredential=qorpera-native-bridge:/var/lib/qorpera-bootstrap/credentials/qorpera-native-bridge
ExecStart=/usr/bin/node /opt/qorpera-runner/qorpera-ephemeral-runner.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=control-group
KillSignal=SIGTERM
UMask=0077
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/qorpera-runner /var/lib/qorpera-native-workspace /run/qorpera-runner
InaccessiblePaths=/var/lib/qorpera/identity /var/lib/qorpera-bootstrap /var/lib/qorpera-native-provider -/qorpera/company-live
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
