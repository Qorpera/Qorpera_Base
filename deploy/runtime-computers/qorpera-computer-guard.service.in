[Unit]
Description=Qorpera funded @PROVIDER@ computer start and expiry guard
After=snap.lxd.daemon.service

[Service]
Type=notify
NotifyAccess=all
User=@ACCOUNT@
Group=@ACCOUNT@
SupplementaryGroups=lxd
ExecStart=/usr/bin/node /opt/qorpera/computer-guard/qorpera-runtime-computer-guard.mjs --provider @PROVIDER@
StateDirectory=qorpera-@PROVIDER@-computer-guard
StateDirectoryMode=0700
RuntimeDirectory=qorpera-@PROVIDER@-computer-guard
RuntimeDirectoryMode=0700
Restart=always
RestartSec=1s
WatchdogSec=15s
TimeoutStartSec=20s
TimeoutStopSec=10s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryMax=256M
TasksMax=64
LimitCORE=0

[Install]
WantedBy=multi-user.target
