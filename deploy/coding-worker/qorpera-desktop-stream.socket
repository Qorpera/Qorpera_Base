[Unit]
Description=Qorpera: the executor's way to watch a desktop, one instance per connection
Documentation=file:///opt/qorpera-coding-executor/README.md

[Socket]
# Only root and the executor's account may connect (20260930745000; the lead's decision after review r11 of #1746).
ListenStream=/run/qorpera-desktop-stream.sock
SocketUser=root
SocketGroup=qorpera-coding-executor
SocketMode=0660
RemoveOnStop=yes
# One instance of qorpera-desktop-stream@.service for each connection, the connection its standard input.
Accept=yes
# The executor watches at most 8 desktops (MAX_WATCHED_DESKTOPS); a ninth connection is closed by systemd at once.
MaxConnections=8
# Past this many connections in 2 s systemd fails this socket and it stays failed until an operator resets it. The
# executor starts at most one instance every 500 ms (one desktop's at most every 2 s): at most 5 in any 2 s, a tenth
# of this.
TriggerLimitIntervalSec=2s
TriggerLimitBurst=50

[Install]
WantedBy=sockets.target
