[Unit]
Description=Qorpera isolated coding VM executor and command gateway
After=network-online.target snap.lxd.daemon.service
Wants=network-online.target

[Service]
Type=simple
User=qorpera-coding-executor
Group=qorpera-coding-executor
# qorpera-agent-plug: the executor plugs every machine it makes into the node's agent exit
# (deploy/agent-exit, qorpera-agent-plug.py plug) right before the create. The exit must be installed first: a
# missing group or folder fails the start.
SupplementaryGroups=lxd qorpera-agent-plug
# The plug tool writes the client map entry and the lease, nothing else of the exit's state. Its lock (plug.lock,
# which the exit makes) it opens read-only: flock needs no write access.
ReadWritePaths=/var/lib/qorpera-agent-exit/clients /var/lib/qorpera-agent-exit/dhcp-hosts
# The host leases of the member machines this executor holds, which qorpera-coding-host-watchdog.service reads
# (README, "Host leases and the host watchdog"). Kept across restarts, so a restart inside the 90 s lease stops
# no machine; gone at reboot.
RuntimeDirectory=qorpera-coding-host
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# Deployment must install a drop-in with RequiresMountsFor=<dedicated NAS mount>
# and ReadWritePaths=<the same NAS mount point, the policy's mountPoint>. Missing mount fails closed.
# Not a folder below it: its bind would be a mount whose root is that folder, which the storage check refuses.
ExecStart=/usr/bin/node /opt/qorpera-coding-executor/qorpera-coding-executor.mjs
LoadCredential=qorpera-coding-executor-config:/etc/qorpera/coding-executor.json
LoadCredential=qorpera-coding-registry:/etc/qorpera/coding-registry.key
LoadCredential=qorpera-coding-command:/etc/qorpera/coding-command.key
# v6: a distinct token for this node's local-only peer command listener.
LoadCredential=qorpera-coding-peer-command:/etc/qorpera/coding-peer-command.key
# Every commandPeers entry also needs a reviewed drop-in LoadCredential for
# its tokenCredential. Peer HTTPS proxies target peerCommandPort, never the
# public commandPort. Each node's peer token must be unique.
# The executor's own broker token (config "broker.executorTokenCredential"): the
# value company brokers load as qorpera-cloud-secret-coding-executor. Never the
# runtime token guests hold. Repository tokens come from each company's GitHub
# connection through its broker. Required: a missing file fails the start.
LoadCredential=qorpera-coding-broker-executor:/etc/qorpera/coding-broker-executor.key
# Proof-only: a repository configured with a static "credential" needs its own
# LoadCredential=qorpera-coding-repository-NAME:<file> in a reviewed drop-in.
Restart=on-failure
RestartSec=5s
# A SIGTERM mid-turn still detaches each running session from its member's
# machine (45 s budget, CLEANUP_STOP_BUDGET_MS); a kill during a machine's
# lifecycle step would leave it recovery-required. Keep this well above the budget.
TimeoutStopSec=75s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# The Git broker's bubblewrap sandbox mounts a fresh /proc, which a masked
# parent /proc (ProtectKernelTunables) forbids; the executor has no
# capabilities, so /proc/sys stays unwritable anyway.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK: bubblewrap brings up the sandbox's loopback over NETLINK_ROUTE.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
UMask=0077
MemoryMax=2G
TasksMax=512
CPUQuota=200%
LimitCORE=0

[Install]
WantedBy=multi-user.target
