[Unit]
Description=Qorpera isolated coding VM executor and command gateway
After=network-online.target snap.lxd.daemon.service
Wants=network-online.target

[Service]
Type=simple
User=qorpera-coding-executor
Group=qorpera-coding-executor
SupplementaryGroups=lxd
# Deployment must install a drop-in with RequiresMountsFor=<dedicated NAS mount>
# and ReadWritePaths=<dedicated service-owned NAS root>. Missing mount fails closed.
ExecStart=/usr/bin/node /opt/qorpera-coding-executor/qorpera-coding-executor.mjs
LoadCredential=qorpera-coding-executor-config:/etc/qorpera/coding-executor.json
LoadCredential=qorpera-coding-registry:/etc/qorpera/coding-registry.key
LoadCredential=qorpera-coding-command:/etc/qorpera/coding-command.key
# The executor's own broker token (config "broker.executorTokenCredential"): the
# value company brokers load as qorpera-cloud-secret-coding-executor. Never the
# runtime token guests hold. Repository tokens come from each company's GitHub
# connection through its broker. Required: a missing file fails the start.
LoadCredential=qorpera-coding-broker-executor:/etc/qorpera/coding-broker-executor.key
# Proof-only: a repository configured with a static "credential" needs its own
# LoadCredential=qorpera-coding-repository-NAME:<file> in a reviewed drop-in.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# The Git broker's bubblewrap sandbox mounts a fresh /proc, which a masked
# parent /proc (ProtectKernelTunables) forbids; the executor has no
# capabilities, so /proc/sys stays unwritable anyway.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK: bubblewrap brings up the sandbox's loopback over NETLINK_ROUTE.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
UMask=0077
MemoryMax=2G
TasksMax=512
CPUQuota=200%
LimitCORE=0

[Install]
WantedBy=multi-user.target
