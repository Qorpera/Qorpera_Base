#!/bin/bash
# The machine's desktop, for work that needs a screen: testing a product in a browser, driving an app's interface.
# Installed as /usr/local/bin/desktop. Agents run it with machine_run (as root); `desktop help` says what it does.
set -euo pipefail
export DISPLAY=:1
UNIT=qorpera-machine-desktop.service
usage() {
	cat <<'EOF'
desktop start                 start the desktop (1600x1000, XFCE, Chromium); does nothing when it runs
desktop stop                  stop it and every program on it
desktop status                running or stopped, and the open windows
desktop shot FILE             save a PNG of the whole screen to FILE (for example a file of yours under /company,
                              then read it with company_read to see the screen); prints FILE, its size and pixels
desktop open URL              open URL in Chromium on the desktop, maximized (a new window or tab)
desktop run PROGRAM [ARG...]  start a program on the desktop as the desktop's user; it keeps running after this ends
                              (programs on the desktop save in /home/desktop: copy what matters into /company as root)
desktop click X Y [BUTTON]    click at X,Y (pixels from the top left); BUTTON left (default), middle or right
desktop double X Y            double-click at X,Y
desktop move X Y              move the pointer to X,Y
desktop drag X1 Y1 X2 Y2      press at X1,Y1, move to X2,Y2 and release
desktop type TEXT             type TEXT into the focused window
desktop key KEY...            press keys, for example Return, ctrl+l, ctrl+shift+t, Escape, Tab
desktop scroll up|down [N]    scroll N steps (default 3) where the pointer is
desktop windows               list the open windows: id, desktop, title
EOF
}
running() { [[ $(systemctl is-active "$UNIT" 2>/dev/null || true) == active ]] && [[ -S /tmp/.X11-unix/X1 ]]; }
need() { running || { echo "the desktop is not running: desktop start" >&2; exit 1; }; }
number() { [[ ${1:-} =~ ^[0-9]{1,5}$ ]] || { echo "not a pixel position: ${1:-}" >&2; exit 2; }; }
# A program on the desktop runs in a unit of its own in the machine's slice, as the desktop's user: it outlives the
# command that started it and stops with the desktop. Requisite refuses its start unless the desktop is active, and
# BindsTo stops it whenever the desktop stops, so no program outlives a stop however the two race. Its arguments
# reach it as given: no $ expansion by systemd.
launch() {
	systemd-run --quiet --collect --expand-environment=no --slice=qorpera-machine.slice --uid=desktop --gid=desktop \
		-p WorkingDirectory=/home/desktop -p Requisite="$UNIT" -p BindsTo="$UNIT" -p After="$UNIT" \
		--setenv=HOME=/home/desktop --setenv=DISPLAY=:1 --setenv=XDG_RUNTIME_DIR=/run/qorpera-desktop -- "$@"
}
command=${1:-help}
shift || true
# Starting, stopping and launching take turns, so a stop never meets a launch half done.
case $command in
start | stop | open | run)
	exec 9>/run/qorpera-desktop.lock
	flock 9
	;;
esac
case $command in
start)
	if ! running; then
		systemctl start "$UNIT"
		for _ in $(seq 1 100); do running && break; sleep 0.1; done
		running || { echo "the desktop did not start" >&2; journalctl -u "$UNIT" -n 20 --no-pager >&2; exit 1; }
		# The session draws its panel and background a moment after the display is up.
		for _ in $(seq 1 50); do wmctrl -m >/dev/null 2>&1 && break; sleep 0.2; done
	fi
	echo "desktop running on display :1 ($(xdpyinfo | awk '/dimensions:/ {print $2}'))"
	;;
stop)
	systemctl stop "$UNIT"
	echo "desktop stopped"
	;;
status)
	if running; then
		echo "running ($(xdpyinfo | awk '/dimensions:/ {print $2}'))"
		wmctrl -l || true
	else
		echo "stopped"
	fi
	;;
shot)
	need
	file=${1:?desktop shot FILE}
	[[ $file == *.png ]] || { echo "FILE must end in .png" >&2; exit 2; }
	mkdir -p -- "$(dirname -- "$file")"
	scrot --overwrite --silent -- "$file"
	echo "$file $(stat -c %s -- "$file") bytes $(file -b -- "$file" | sed -n 's/.*, \([0-9]* x [0-9]*\),.*/\1/p')"
	;;
open)
	need
	url=${1:?desktop open URL}
	launch chromium --start-maximized --no-first-run --no-default-browser-check --password-store=basic \
		--disable-features=Translate "$url"
	echo "opening $url"
	;;
run)
	need
	(( $# > 0 )) || { echo "desktop run PROGRAM [ARG...]" >&2; exit 2; }
	launch "$@"
	echo "started $1"
	;;
click)
	need
	number "${1:-}"; number "${2:-}"
	case ${3:-left} in left) button=1 ;; middle) button=2 ;; right) button=3 ;; *) echo "BUTTON is left, middle or right" >&2; exit 2 ;; esac
	xdotool mousemove --sync "$1" "$2" click "$button"
	;;
double)
	need
	number "${1:-}"; number "${2:-}"
	xdotool mousemove --sync "$1" "$2" click --repeat 2 --delay 80 1
	;;
move)
	need
	number "${1:-}"; number "${2:-}"
	xdotool mousemove --sync "$1" "$2"
	;;
drag)
	need
	for value in "${1:-}" "${2:-}" "${3:-}" "${4:-}"; do number "$value"; done
	xdotool mousemove --sync "$1" "$2" mousedown 1 sleep 0.1 mousemove --sync "$3" "$4" sleep 0.1 mouseup 1
	;;
type)
	need
	(( $# > 0 )) || { echo "desktop type TEXT" >&2; exit 2; }
	xdotool type --delay 12 -- "$*"
	;;
key)
	need
	(( $# > 0 )) || { echo "desktop key KEY..." >&2; exit 2; }
	xdotool key --delay 40 -- "$@"
	;;
scroll)
	need
	case ${1:-} in up) button=4 ;; down) button=5 ;; *) echo "desktop scroll up|down [N]" >&2; exit 2 ;; esac
	steps=${2:-3}
	[[ $steps =~ ^[0-9]{1,3}$ ]] || { echo "N is a number of steps" >&2; exit 2; }
	xdotool click --repeat "$steps" --delay 30 "$button"
	;;
windows)
	need
	wmctrl -l
	;;
help | -h | --help)
	usage
	;;
*)
	usage >&2
	exit 2
	;;
esac
