# Beside the session, until the display ends. It waits on the window manager's client list and also looks every three
# seconds (an announcement may be lost; the hour, the figure and the time zone change without one): one xprop call and
# two small reads, and nothing more while nothing changed.
watch() {
	local list last=unread kinds= id class app state status zone now figure hour image backdrop ground tone ground_shown= tone_shown=
	# What `write` made is what shows: idle icons, the hour's frame, the clocks' zone, the dock's ground and ink (which
	# it noted). Only a change is told to XFCE.
	zone=$(desktop_zone)
	backdrop=$ART/backdrops/$(backdrop_set)/$(hour_in "$zone").png
	if [[ -s $RUN/dock.ground ]]; then read -r ground_shown <"$RUN/dock.ground" || true; fi
	if [[ -s $RUN/dock.tone ]]; then read -r tone_shown <"$RUN/dock.tone" || true; fi
	while :; do
		if read -r -t 3 _; then
			sleep 0.3
			# A burst of window events costs one pass: drain what is already waiting.
			while read -r -t 0 _ 2>/dev/null; do read -r _ || break; done
		else
			# A timeout (above 128) is the regular look; anything else is the end of the display.
			status=$?
			((status > 128)) || break
		fi
		# The time zone the desktop has now, and the hour in it. The dock's clocks follow the zone.
		now=$(desktop_zone)
		if [[ $now != "$zone" ]]; then
			zone=$now
			for id in 3 7; do
				xfconf-query -c xfce4-panel -p "/plugins/plugin-$id/timezone" -n -t string -s "$zone" >/dev/null 2>&1 || true
			done
		fi
		hour=$(hour_in "$zone")
		# The dock stands on the wallpaper: its ground is the hour's, and its ink the ground's tone. The tone is noted
		# first, so the marks below and a press take it.
		ground=${GROUND[10#$hour]}
		tone=$(tone_of "$ground")
		if [[ $ground != "$ground_shown" ]] && dock_ground "$ground"; then
			ground_shown=$ground
			echo "$ground" >"$RUN/dock.ground"
		fi
		if [[ $tone != "$tone_shown" ]] && echo "$tone" >"$RUN/dock.tone" && dock_ink "$tone"; then tone_shown=$tone; fi
		# The marks: a program with a window, minimised or not, has the mark under its icon.
		list=$(clients) || list=
		if [[ $list != "$last" ]]; then
			last=$list
			kinds=$(classes "$list")
		fi
		for app in browser files terminal; do
			# A press that waits for the browser owns its icon meanwhile (its note names it; a press that is gone
			# owns nothing).
			if [[ $app == browser && -s $RUN/dock-browser.launching ]] &&
				kill -0 "$(<"$RUN/dock-browser.launching")" 2>/dev/null; then
				continue
			fi
			state=idle
			while read -r id class; do
				[[ -n $class && $class =~ ${WINDOW_CLASS[$app]} ]] && state=running
			done <<<"$kinds"
			show "$app" "$state"
		done
		# The backdrop: the set of the figure the machine names now, the frame of the hour in the desktop's time zone.
		figure=$(backdrop_set)
		image=$ART/backdrops/$figure/$hour.png
		if [[ $image != "$backdrop" && -f $image ]]; then
			while read -r id; do
				xfconf-query -c xfce4-desktop -p "$id" -s "$image" >/dev/null 2>&1 || true
			done < <(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$')
			backdrop=$image
		fi
	done < <(xprop -root -spy _NET_CLIENT_LIST 2>/dev/null)
}

# A press on a dock icon. Every icon first brings back the window its program already has on this screen. Only when
# there is none is the program asked for: an empty file named for it in ASK, which root answers by starting it the way
# `desktop open` and `desktop run` do, as a unit of its own (desktop-dock-open), so the browser a press opens is the
# one an agent's `desktop open` finds, and the memory guard meets it as it meets any program on the desktop. It never
# opens a dialog: the browser's icon shows an outlined mark and pulses for the first seconds, and a browser that did
# not come turns it grey with an amber mark for a few seconds.
press() { # app
	local app=$1 attempt attempts=40
	raise "$app" && return 0
	[[ $app != browser ]] || show browser launching
	# One wait at a time for a program: impatient presses do not stack up. A press made while another waits does
	# nothing, so the wait is short: the files and a terminal come in a quarter of a second, the browser in one.
	exec 9>"$RUN/dock-$app.lock" || return 1
	flock -n 9 || return 0
	if [[ $app == browser ]]; then
		echo "$$" >"$RUN/dock-browser.launching"
		trap 'rm -f -- "$RUN/dock-browser.launching"' EXIT
	fi
	: >"$ASK/$app" || { echo "the dock cannot ask for the $app: $ASK is not there" >&2; return 1; }
	# A cold start on a busy machine takes its time: 10 s for the files and a terminal, 20 s for the browser.
	[[ $app != browser ]] || attempts=80
	for ((attempt = 0; attempt < attempts; attempt++)); do
		sleep 0.25
		if raise "$app"; then
			show "$app" running
			return 0
		fi
		# Six beats in the first three seconds, then the still outlined mark. Never a continuous animation.
		if [[ $app == browser ]] && ((attempt < 12)); then
			if ((attempt % 2 == 0)); then show browser launching-2; else show browser launching; fi
		fi
	done
	[[ $app == browser ]] || return 1
	show browser failed
	sleep 6
	if raise browser; then show browser running; else show browser idle; fi
	return 1
}

case ${1:-} in
write)
	write || { echo "the desktop's look could not be written whole" >&2; exit 1; }
	;;
watch)
	watch
	;;
press)
	case ${2:-} in
	browser | files | terminal) ;;
	*) echo "desktop-look press browser|files|terminal" >&2; exit 64 ;;
	esac
	[[ -n ${DISPLAY:-} && $# == 2 ]] || { echo "desktop-look press browser|files|terminal (on the desktop)" >&2; exit 64; }
	press "$2"
	;;
*)
	echo "desktop-look write|watch|press APP" >&2
	exit 64
	;;
esac
