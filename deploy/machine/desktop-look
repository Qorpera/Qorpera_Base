  <property name="misc-default-geometry" type="string" value="110x30"/>
  <property name="scrolling-bar" type="string" value="TERMINAL_SCROLLBAR_NONE"/>
  <property name="font-use-system" type="bool" value="false"/>
  <property name="font-name" type="string" value="DejaVu Sans Mono 11"/>
  <property name="color-foreground" type="string" value="#e6e9ef"/>
  <property name="color-background" type="string" value="#12141a"/>
  <property name="color-cursor" type="string" value="#7ee787"/>
  <property name="color-cursor-use-default" type="bool" value="false"/>
  <property name="color-palette" type="string" value="#1b1f2a;#f47067;#7ee787;#f5a524;#5aa9ff;#c297ff;#56d4dd;#c9ced8;#565d6b;#ff938a;#a5f3ae;#ffd166;#8cc4ff;#d8b9ff;#8ae7ee;#ffffff"/>
  <property name="run-custom-command" type="bool" value="true"/>
  <property name="custom-command" type="string" value="/usr/bin/bash --rcfile &quot;$CONFIG/qorpera-bashrc&quot;"/>
</channel>
TERMINAL
	put "$CONFIG/xfce4/terminal/terminalrc" <<TERMINAL || return 1
[Configuration]
TitleInitial=Terminal
TitleMode=TERMINAL_TITLE_HIDE
