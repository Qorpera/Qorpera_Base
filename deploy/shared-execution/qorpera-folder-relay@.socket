[Unit]
Description=Qorpera folder relay socket for slot %i (the node's folder search, F3)

[Socket]
# Only the slot's native host account opens it. The shared execution service starts it before the host when the
# node's folder search is on (QORPERA_SHARED_EXECUTION_FOLDER_SEARCH=on).
ListenStream=/run/qorpera-folder-relay/%i.sock
SocketUser=qorpera-shared-host-%i
SocketGroup=qorpera-shared-host-%i
SocketMode=0600
DirectoryMode=0755
Service=qorpera-folder-relay@%i.service
