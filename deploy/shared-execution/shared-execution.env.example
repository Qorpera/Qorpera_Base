# Shared execution service (one execution host VM per node). Secrets are NOT
# set here: the provider token and the host's other credentials are systemd
# credentials in /etc/qorpera/shared-execution-credentials/ (root:root 0600).
# The service key never enters this host (G2-5): the service refuses to start
# with one there, in its credentials or in this environment.
QORPERA_SUPABASE_URL=https://REPLACE.supabase.co
QORPERA_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# The node's native adapter id: identity homes and runner rows are keyed by it.
QORPERA_RUNNER_PROVIDER_ADAPTER=native26-phql-b1
QORPERA_SHARED_EXECUTION_HOST_ID=qorpera-exec-node02
QORPERA_RUNNER_NODE_ID=REPLACE_WITH_NODE_UUID
QORPERA_RUNNER_PROVIDER_HOST=127.0.0.1
QORPERA_RUNNER_PROVIDER_PORT=18450
QORPERA_RUNNER_PROVIDER_SOFTWARE_VERSION=REPLACE_WITH_SOURCE_COMMIT
QORPERA_SHARED_EXECUTION_SLOTS=16
QORPERA_SHARED_EXECUTION_PORT_BASE=20000
QORPERA_SHARED_EXECUTION_STATE_ROOT=/var/lib/qorpera-shared-execution
QORPERA_SHARED_EXECUTION_RUN_ROOT=/run/qorpera-shared-execution
QORPERA_SHARED_EXECUTION_IDENTITY_ROOT=/var/lib/qorpera/identities
QORPERA_SHARED_EXECUTION_START_TIMEOUT_MS=30000
# Runner image contract (deploy/lxd-runner-guest/runner-image-contract.json).
QORPERA_EPHEMERAL_RUNNER_IMAGE=localhost/qorpera/sandbox-probe:REPLACE@sha256:REPLACE
QORPERA_EPHEMERAL_RUNNER_PODMAN=/usr/bin/podman
QORPERA_EPHEMERAL_RUNNER_ENTRYPOINT=/qorpera/bin/run-job
QORPERA_EPHEMERAL_RUNNER_VERSION=REPLACE_WITH_SOURCE_COMMIT
QORPERA_CODEX_PATH=/opt/qorpera-harnesses/native-company/codex
QORPERA_CLAUDE_PATH=/usr/local/bin/claude
# Governed company-path-v1 runtime (same names as the LXD provider).
QORPERA_NATIVE_RUNTIME=company-path-v1
QORPERA_NATIVE_CODEX_FENCE_PATH=/opt/qorpera-harnesses/native-company/codex
QORPERA_NATIVE_CODEX_FENCE_SHA256=REPLACE_WITH_FENCE_SHA256
QORPERA_NATIVE_OBJECT_GATEWAY_URL=https://REPLACE:10000
QORPERA_LXD_NATIVE_OBJECT_TOKEN_FILE=/etc/qorpera/shared-execution-credentials/native-object-token
QORPERA_CLOUD_SECRET_BROKER_URL=https://REPLACE:10443
QORPERA_LXD_CLOUD_SECRET_RUNTIME_TOKEN_FILE=/etc/qorpera/shared-execution-credentials/cloud-secret-runtime
QORPERA_LXD_CLOUD_SECRET_CA_FILE=/etc/qorpera/shared-execution-credentials/cloud-secret-ca.crt
QORPERA_LXD_CLOUD_SECRET_CA_SHA256=REPLACE_WITH_CA_SHA256
# Coding sessions (Order 9), both or neither; the gateway certificate must chain to the CA above.
# QORPERA_CODING_COMMAND_URL=https://REPLACE:8789
# QORPERA_LXD_CODING_COMMAND_TOKEN_FILE=/etc/qorpera/shared-execution-credentials/coding-command-token
QORPERA_LXD_OFFICE_ROUTES_FILE=/etc/qorpera/shared-execution-credentials/office-routes.json
# Warm conversations (contract amendment 2026-09-27), at most 300000 (5 minutes); off when unset.
# QORPERA_SHARED_EXECUTION_WARM_IDLE_MS=300000
# Required by the shared governed-runtime parser; unused by sandboxes.
QORPERA_LXD_COMPANY_NETWORK=qorpera0
QORPERA_LXD_RECOVERY_VOLUME_PREFIX=phql-a1-recovery-
QORPERA_LXD_RECOVERY_VOLUME_SIZE=4GiB
