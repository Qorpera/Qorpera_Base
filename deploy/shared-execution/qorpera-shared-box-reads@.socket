[Unit]
Description=Qorpera shared execution: the read log of slot %i's run box (only the slot's native host opens it)
Documentation=https://github.com/Qorpera/Qorpera_Base
# Goes with the box's folder unit, which serves it.
PartOf=qorpera-shared-box-folder@%i.service

[Socket]
ListenStream=/run/qorpera-shared-box/%i.reads
SocketUser=qorpera-shared-host-%i
SocketGroup=qorpera-shared-host-%i
SocketMode=0600
DirectoryMode=0755
Accept=no
RemoveOnStop=yes
Service=qorpera-shared-box-folder@%i.service
# No [Install]: started with the box's folder unit and stopped with it.
