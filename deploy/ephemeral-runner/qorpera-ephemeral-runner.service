[Unit]
Description=Qorpera ephemeral cloud runner
Documentation=https://github.com/Qorpera/Qorpera_Base
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
Environment=QORPERA_RUNNER_CONFIG=%h/.config/qorpera-runner/config.json
LoadCredential=qorpera-runner-activation
ExecStart=/usr/bin/node /opt/qorpera-runner/qorpera-ephemeral-runner.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
Delegate=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
