[Unit]
Description=Qorpera ephemeral cloud runner
Documentation=https://github.com/Qorpera/Qorpera_Base
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
Environment=QORPERA_RUNNER_CONFIG=%h/.config/qorpera-runner/config.json
Environment=PODMAN_NO_PAUSE_PROCESS=1
LoadCredential=qorpera-runner-activation
LoadCredential=qorpera-runner-repair
ExecStart=/usr/bin/node /opt/qorpera-runner/qorpera-ephemeral-runner.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
Delegate=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h %t
ProtectHostname=yes
ProtectClock=yes

[Install]
WantedBy=default.target
