[Unit]
Description=Qorpera ephemeral cloud runner
Documentation=https://github.com/Qorpera/Qorpera_Base
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
Environment=QORPERA_RUNNER_CONFIG=%h/.config/qorpera-runner/config.json
# ImportCredential tolerates an absent credential; LoadCredential without a
# source path is fatal on some systemd versions once the one-time file is
# deleted after consumption, which would block every later restart.
ImportCredential=qorpera-runner-activation
ImportCredential=qorpera-runner-repair
ExecStart=/usr/bin/node /opt/qorpera-runner/qorpera-ephemeral-runner.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
Delegate=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h %t
ProtectHostname=yes
ProtectClock=yes

[Install]
WantedBy=default.target
