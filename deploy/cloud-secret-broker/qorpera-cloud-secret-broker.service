[Unit]
Description=Qorpera company-centered cloud secret broker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=qorpera-secret-broker
Group=qorpera-secret-broker
LoadCredential=qorpera-cloud-secret-config:/etc/qorpera-secret-broker/config.json
LoadCredential=qorpera-cloud-secret-database-url:/etc/qorpera-secret-broker/database-url
LoadCredential=qorpera-cloud-secret-database-ca:/etc/qorpera-secret-broker/supabase-prod-ca-2021.crt
LoadCredential=qorpera-cloud-secret-control:/etc/qorpera-secret-broker/control
LoadCredential=qorpera-cloud-secret-runtime:/etc/qorpera-secret-broker/runtime
LoadCredential=qorpera-cloud-secret-keyring:/etc/qorpera-secret-broker/keyring.json
ExecStart=/usr/bin/node /opt/qorpera-secret-broker/qorpera-cloud-secret-broker-service.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=32
CPUQuota=100%

[Install]
WantedBy=multi-user.target
