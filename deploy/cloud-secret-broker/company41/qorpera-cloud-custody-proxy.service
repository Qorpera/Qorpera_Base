[Unit]
Description=Qorpera Company41 private custody TLS endpoint
Wants=network-online.target tailscaled.service qorpera-identity-recovery.service
After=network-online.target tailscaled.service qorpera-cloud-secret-broker-canary.service qorpera-identity-recovery.service
Requires=qorpera-cloud-secret-broker-canary.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=qorpera-secret-proxy
Group=qorpera-secret-proxy
LoadCredentialEncrypted=qorpera-cloud-custody-tls-key
LoadCredentialEncrypted=qorpera-cloud-custody-tls-cert
RuntimeDirectory=qorpera-custody-proxy
RuntimeDirectoryMode=0750
CacheDirectory=qorpera-custody-proxy/client
CacheDirectory=qorpera-custody-proxy/proxy
CacheDirectoryMode=0700
ExecStart=/usr/sbin/nginx -c /etc/qorpera-secret-broker/custody-proxy.conf -g "daemon off;"
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=24
CPUQuota=50%

[Install]
WantedBy=multi-user.target
