[Unit]
Description=Qorpera Step 2 secret capture TLS proxy
Wants=network-online.target
After=network-online.target qorpera-cloud-secret-broker-canary.service
Requires=qorpera-cloud-secret-broker-canary.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=qorpera-secret-proxy
Group=qorpera-secret-proxy
LoadCredentialEncrypted=qorpera-step2-canary-tls-key
LoadCredentialEncrypted=qorpera-step2-canary-tls-cert
RuntimeDirectory=qorpera-secret-capture-proxy
RuntimeDirectoryMode=0750
CacheDirectory=qorpera-secret-capture-proxy
CacheDirectory=qorpera-secret-capture-proxy/client
CacheDirectory=qorpera-secret-capture-proxy/proxy
CacheDirectoryMode=0700
ExecStart=/usr/sbin/nginx -c /etc/qorpera-secret-broker/capture-proxy.conf -g "daemon off;"
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=24
CPUQuota=50%

[Install]
WantedBy=multi-user.target
