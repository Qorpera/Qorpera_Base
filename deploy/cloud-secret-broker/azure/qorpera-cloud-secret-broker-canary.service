[Unit]
Description=Qorpera Step 2 cloud secret broker canary
Wants=network-online.target
After=network-online.target qorpera-step2-secret-canary-destination.service
Requires=qorpera-step2-secret-canary-destination.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=qorpera-secret-broker
Group=qorpera-secret-broker
LoadCredentialEncrypted=qorpera-cloud-secret-config
LoadCredentialEncrypted=qorpera-cloud-secret-database-url
LoadCredential=qorpera-cloud-secret-database-ca:/usr/local/lib/qorpera-step2-secret-canary/supabase-prod-ca-2021.crt
LoadCredentialEncrypted=qorpera-cloud-secret-control
LoadCredentialEncrypted=qorpera-cloud-secret-runtime
LoadCredentialEncrypted=qorpera-cloud-secret-keyring
LoadCredentialEncrypted=qorpera-step2-canary-ca-cert
Environment=NODE_EXTRA_CA_CERTS=/run/credentials/qorpera-cloud-secret-broker-canary.service/qorpera-step2-canary-ca-cert
ExecStart=/usr/local/bin/node /usr/local/lib/qorpera-step2-secret-canary/qorpera-cloud-secret-broker-canary-service.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=32
CPUQuota=100%

[Install]
WantedBy=multi-user.target
