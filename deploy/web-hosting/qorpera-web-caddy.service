[Unit]
Description=Qorpera Web Edge Caddy TLS Terminator
After=network-online.target qorpera-web-router.service
Wants=network-online.target qorpera-web-router.service

[Service]
Type=notify
User=caddy
Group=caddy
SupplementaryGroups=qorpera-web
StateDirectory=qorpera-web-certs
Environment=XDG_DATA_HOME=/var/lib/qorpera-web-certs
Environment=XDG_CONFIG_HOME=/var/lib/qorpera-web-certs/config
EnvironmentFile=-/etc/qorpera-web/edge.env
ExecStart=/usr/bin/caddy run --environ --config /etc/qorpera-web/Caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/qorpera-web/Caddyfile --force
TimeoutStopSec=5s
LimitCORE=0
LimitNOFILE=1048576
MemoryMax=512M
MemorySwapMax=0
TasksMax=4096
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/qorpera-web-certs -/run/qorpera-web-router
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
