[Unit]
Description=Qorpera Company Computer delta-sync agent
Documentation=https://github.com/Qorpera/Qorpera_Base
Wants=network-online.target
After=network-online.target qorpera-company-computer-bootstrap.service
ConditionPathExists=/var/lib/qorpera-bootstrap/company-computer.json
RequiresMountsFor=/srv/qorpera/dataset

[Service]
Type=exec
User=qorpera-runner
Group=qorpera-runner
WorkingDirectory=/srv/qorpera/dataset
Environment=HOME=/srv/qorpera/dataset/workbench
# Storage selection is explicit and fails closed; production NAS-primary
# deployments override this through a drop-in with the gateway URL and token.
Environment=QORPERA_OBJECT_STORAGE_PRIMARY=supabase
LoadCredential=company-computer.json:/var/lib/qorpera-bootstrap/company-computer.json
LoadCredential=runner-config.json:/var/lib/qorpera-bootstrap/runner-config.json
LoadCredential=qorpera-supabase-service-key:/var/lib/qorpera-bootstrap/credentials/qorpera-supabase-service-key
ExecStart=/usr/bin/node /opt/qorpera-company-computer/qorpera-company-computer-sync.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/qorpera/dataset
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
