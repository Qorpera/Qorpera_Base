#!/usr/bin/env bash
set -euo pipefail
umask 0077

# Computer-specific wrapper adapted from codex/step3-remaining-ops. The
# authenticated guest supervisor must verify containment before invocation,
# supply ONLY the environment below, and reap this entire service on recovery.
# No service/provider credentials, canonical Company File mount, or ambient
# browser profile is admitted here. Browser launch belongs to the grant broker.
if [[ $# -ne 3 ]]; then
	echo "usage: qorpera-screen-session <screen_uuid> <ordinal> <display>" >&2
	exit 64
fi
screen_id=$1
ordinal=$2
display=$3
if [[ ! ${screen_id} =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ||
	! ${ordinal} =~ ^([1-9]|[12][0-9]|3[0-2])$ || ${display} != ":${ordinal}" ]]; then
	echo "Invalid screen binding." >&2
	exit 64
fi
workbench_root=${QORPERA_WORKBENCH_ROOT:?Required noncanonical workbench}
desktop_home=${QORPERA_DESKTOP_HOME:?Required desktop home}
screen_state_root=${QORPERA_SCREEN_STATE_ROOT:?Required desktop state root}
runtime_root=${QORPERA_SCREEN_RUNTIME_ROOT:?Required supervisor-owned ephemeral runtime root}
for directory in "${workbench_root}" "${desktop_home}" "${screen_state_root}" "${runtime_root}"; do
	if [[ ${directory} != /* || ${directory} == / || ! -d ${directory} || -L ${directory} ||
		$(/usr/bin/realpath -e -- "${directory}") != "${directory}" ||
		${directory} =~ (^|/)(live|company-live|identity|credentials|\.codex|\.claude)(/|$) ]]; then
		echo "Unsafe desktop directory." >&2
		exit 65
	fi
done
screen_state="${screen_state_root}/${screen_id}"
runtime_dir="${runtime_root}/${screen_id}"
mkdir -p "${screen_state}" "${screen_state}/config" "${screen_state}/cache" "${screen_state}/data" "${runtime_dir}"
for directory in "${screen_state}" "${screen_state}/config" "${screen_state}/cache" "${screen_state}/data" "${runtime_dir}"; do
	if [[ -L ${directory} || $(/usr/bin/realpath -e -- "${directory}") != "${directory}" ]]; then
		echo "Unsafe desktop state alias." >&2
		exit 65
	fi
done
wallpaper=${QORPERA_SCREEN_WALLPAPER:?Required agent wallpaper from the verified guest helper}
if [[ ${wallpaper} != "${screen_state}/wallpaper.png" || ! -s ${wallpaper} || ! -f ${wallpaper} ||
	-L ${wallpaper} || $(/usr/bin/realpath -e -- "${wallpaper}") != "${wallpaper}" ||
	! -x /usr/local/bin/qorpera-screen-xfce ]]; then
	echo "The bound screen wallpaper or desktop helper is unavailable." >&2
	exit 65
fi
# Optional desktop appearance published by the verified guest helper next to
# the wallpaper: an hourly backdrop set (tone-on-tone agent figure following
# the company's local day) and the IANA zone that keeps the desktop clock,
# terminal and backdrop cycle on that local time. Absent files keep UTC and
# the static wallpaper; malformed files are refused, never guessed at.
time_zone=Etc/UTC
if [[ -e ${screen_state}/time-zone ]]; then
	if [[ -L ${screen_state}/time-zone || ! -f ${screen_state}/time-zone ]]; then
		echo "Unsafe screen time zone." >&2
		exit 65
	fi
	read -r time_zone < "${screen_state}/time-zone" || true
	if [[ ! ${time_zone} =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}$ || ${#time_zone} -gt 64 ||
		! -f /usr/share/zoneinfo/${time_zone} ]]; then
		echo "Unsafe screen time zone." >&2
		exit 65
	fi
fi
backdrops=""
if [[ -e ${screen_state}/backdrops ]]; then
	backdrops="${screen_state}/backdrops"
	if [[ -L ${backdrops} || ! -d ${backdrops} || $(/usr/bin/realpath -e -- "${backdrops}") != "${backdrops}" ]]; then
		echo "Unsafe screen backdrop set." >&2
		exit 65
	fi
	for ((h = 0; h < 24; h++)); do
		printf -v hour '%02d' "${h}"
		if [[ -L ${backdrops}/${hour}.png || ! -s ${backdrops}/${hour}.png || ! -f ${backdrops}/${hour}.png ]]; then
			echo "Incomplete screen backdrop set." >&2
			exit 65
		fi
	done
fi
# One flat dark bar along the bottom edge is the whole desktop chrome: the three
# office tools centred (browser, files, terminal), the date at the left and the
# time at the right. There is no
# top bar and no window list: the dock icons show what is open, and the company
# browser opens maximised. Chromium itself only ever starts through the office
# service; the launcher raises or requests it. Everything is rewritten on each
# start so the desktop never drifts from the image recipe.
panel_config="${screen_state}/config/xfce4/xfconf/xfce-perchannel-xml"
launchers="${screen_state}/config/xfce4/panel"
terminal_config="${screen_state}/config/xfce4/terminal"
gtk_config="${screen_state}/config/gtk-3.0"
dock_state="${screen_state}/config/qorpera-dock"
mkdir -p "${panel_config}" "${launchers}/launcher-4" "${launchers}/launcher-5" "${launchers}/launcher-6" \
	"${terminal_config}" "${gtk_config}" "${dock_state}"
for directory in "${panel_config}" "${launchers}" "${launchers}/launcher-4" "${launchers}/launcher-5" \
	"${launchers}/launcher-6" "${terminal_config}" "${gtk_config}" "${dock_state}"; do
	if [[ -L ${directory} || $(/usr/bin/realpath -e -- "${directory}") != "${directory}" ]]; then
		echo "Unsafe desktop configuration alias." >&2
		exit 65
	fi
done
# Generated files are written in a fresh private directory and renamed into
# place: no predictable temporary name that something inside the desktop could
# have planted, and the panel never reads half a file. A writer reports failure
# instead of exiting; what the session needs is checked, what is only looks is not.
rm -rf -- "${screen_state}/config"/.qorpera-* 2>/dev/null || true
scratch=$(mktemp -d "${screen_state}/config/.qorpera-write.XXXXXXXX")
install_generated() {
	local temporary=$1 target=$2
	if [[ -d ${target} && ! -L ${target} ]]; then
		rm -f -- "${temporary}"
		return 1
	fi
	mv -f -- "${temporary}" "${target}"
}
write_desktop_file() {
	local target=$1 temporary
	temporary=$(mktemp "${scratch}/file.XXXXXXXX") || return 1
	cat > "${temporary}" || return 1
	install_generated "${temporary}" "${target}" || return 1
}
cosmetic() {
	"$@" || echo "Skipped cosmetic desktop file: ${*: -1}" >&2
}
write_desktop_file "${panel_config}/xfce4-panel.xml" <<'PANEL'
