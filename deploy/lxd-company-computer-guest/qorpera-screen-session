# The panel draws with GTK 3, so its look is plain GTK CSS scoped to the panel:
# no button boxes, a soft hover and press highlight, and click feedback on the
# icon itself: it is pushed in while the button is held and jumps once when it
# is let go (one short keyframe run per click, nothing that repeats, so it costs
# a viewer a handful of small updates). The icon gets the full height of the bar
# to move in (negative margin), so the jump is not cut off at the button's edge.
# Nothing here needs a compositor. A rule a GTK version does not know is
# skipped, never fatal.
cosmetic write_desktop_file "${gtk_config}/gtk.css" <<'CSS'
@keyframes qorpera-dock-jump {
	0% { -gtk-icon-transform: translateY(2px) scale(0.9); }
	32% { -gtk-icon-transform: translateY(-8px) scale(1.02); }
	58% { -gtk-icon-transform: translateY(0) scale(1); }
	78% { -gtk-icon-transform: translateY(-3px) scale(1); }
	100% { -gtk-icon-transform: translateY(0) scale(1); }
}
.xfce4-panel {
	background-color: #101218;
	background-image: none;
	border: none;
	box-shadow: none;
	color: #e6e9ef;
}
.xfce4-panel button {
	background-color: transparent;
	background-image: none;
	border: none;
	box-shadow: none;
	outline: none;
	border-radius: 16px;
	margin: 4px 3px;
	padding: 0 5px;
	transition: background-color 90ms ease-out;
}
.xfce4-panel button:hover { background-color: rgba(255, 255, 255, 0.10); }
.xfce4-panel button:active,
.xfce4-panel button:checked { background-color: rgba(255, 255, 255, 0.22); }
/* The date at the left and the time at the right take the same width, so the
   three icons between the two expanding gaps sit on the screen's centre line.
   The time is the brighter of the two. */
.xfce4-panel #clock-button label {
	min-width: 120px;
	color: #c9ced8;
}
.xfce4-panel #clock-7 #clock-button label { color: #a3abba; }
.xfce4-panel #clock-3 #clock-button label { color: #eef0f4; }
.xfce4-panel #clock-button:hover,
.xfce4-panel #clock-button:active,
.xfce4-panel #clock-button:checked { background-color: transparent; }
.xfce4-panel button image {
	margin: -4px 0;
	-gtk-icon-transform: translateY(0) scale(1);
	animation: qorpera-dock-jump 420ms ease-out 1;
}
.xfce4-panel button:active image {
	-gtk-icon-transform: translateY(2px) scale(0.9);
	animation: none;
	transition: -gtk-icon-transform 60ms ease-out;
}
CSS
cosmetic write_desktop_file "${gtk_config}/settings.ini" <<'SETTINGS'
[Settings]
gtk-enable-animations=1
gtk-cursor-theme-size=24
gtk-enable-event-sounds=0
gtk-enable-input-feedback-sounds=0
SETTINGS
# The dock icons are original Qorpera drawings (design/dock-icons.js) carried
# here as PNG so they need neither an icon theme nor an SVG loader, and so they
# reach existing computers with this script. `-running` has the white mark
# under the tile; qorpera-screen-xfce shows it while a window is open.
# `browser-launching` (an outlined mark) answers a click while the service opens
# the browser and `browser-launching-2` is the second frame of its short pulse;
# `browser-failed` is the quiet sign that it did not open.
write_dock_icon() {
	local target="${dock_state}/$1.png" temporary
	temporary=$(mktemp "${scratch}/icon.XXXXXXXX") || return 1
	/usr/bin/base64 -d > "${temporary}" || return 1
	install_generated "${temporary}" "${target}" || return 1
}
