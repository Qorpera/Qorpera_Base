# The panel draws with GTK 3, so its look is plain GTK CSS scoped to the panel:
# no button boxes, a soft hover and press highlight, and the icon jumps when it
# is pressed and settles back with a small overshoot. Nothing here needs a
# compositor. A rule a GTK version does not know is skipped, never fatal.
write_desktop_file "${gtk_config}/gtk.css" <<'CSS'
.xfce4-panel {
	background-color: #101218;
	background-image: none;
	border: none;
	box-shadow: none;
	color: #e6e9ef;
}
.xfce4-panel button {
	background-color: transparent;
	background-image: none;
	border: none;
	box-shadow: none;
	outline: none;
	border-radius: 16px;
	margin: 4px 7px;
	padding: 0 6px;
	transition: background-color 90ms ease-out;
}
.xfce4-panel button:hover { background-color: rgba(255, 255, 255, 0.10); }
.xfce4-panel button:active,
.xfce4-panel button:checked { background-color: rgba(255, 255, 255, 0.20); }
/* The date at the left and the time at the right take the same width, so the
   three icons between the two expanding gaps sit on the screen's centre line. */
.xfce4-panel #clock-button label {
	min-width: 120px;
	color: #c9ced8;
}
.xfce4-panel button image {
	-gtk-icon-transform: translateY(0);
	transition: -gtk-icon-transform 360ms cubic-bezier(0.34, 1.9, 0.5, 1);
}
.xfce4-panel button:active image {
	-gtk-icon-transform: translateY(-9px);
	transition: -gtk-icon-transform 70ms ease-out;
}
CSS
write_desktop_file "${gtk_config}/settings.ini" <<'SETTINGS'
[Settings]
gtk-enable-animations=1
gtk-cursor-theme-size=24
gtk-enable-event-sounds=0
gtk-enable-input-feedback-sounds=0
SETTINGS
# The dock icons are original Qorpera drawings (design/dock-icons.js) carried
# here as PNG so they need neither an icon theme nor an SVG loader, and so they
# reach existing computers with this script. `-running` has the dot under the
# tile; qorpera-screen-xfce swaps the launcher entry when a window opens or
# closes. `browser-failed` is the quiet sign that the browser did not open.
write_dock_icon() {
	local target="${dock_state}/$1.png"
	local temporary="${target}.tmp.$$"
	/usr/bin/base64 -d > "${temporary}"
	mv -f -- "${temporary}" "${target}"
}
