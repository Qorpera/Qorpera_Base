# DOCK-ICONS-END
# State templates live outside the launcher's managed directory: XFCE deletes
# a removed `items` entry. Selecting a template by absolute path imports a
# disposable copy while preserving the source for the next transition.
# The panel starts with a separate idle copy in its own directory.
write_dock_launcher() {
	local app=$1 plugin=$2 state=$3 name=$4 comment=$5 command=$6 path=$7 entry
	entry="qorpera-${app}.desktop"
	[[ ${state} == idle ]] || entry="qorpera-${app}-${state}.desktop"
	[[ -z ${path} ]] || path="Path=${path}"$'\n'
	write_desktop_file "${dock_state}/${entry}" <<DESKTOP || return 1
[Desktop Entry]
Version=1.0
Type=Application
Name=${name}
Comment=${comment}
Exec=${command}
${path}Icon=${dock_state}/${app}-${state}.png
Terminal=false
StartupNotify=false
DESKTOP
	if [[ ${state} == idle ]]; then
		write_desktop_file "${launchers}/launcher-${plugin}/${entry}" < "${dock_state}/${entry}"
	fi
}
# Files and Terminal go through the same dock helper as the browser, so a click
# brings back the window that is already there (minimised or not) before it
# starts another. The idle entries are what the panel needs; the other states
# only change the icon. Entries of an earlier revision are not used any more.
dock_helper=/usr/local/bin/qorpera-screen-browser
write_dock_launcher terminal 4 idle Terminal "Shell in the company workbench" "${dock_helper} terminal" "${workbench_root}"
write_dock_launcher files 5 idle Files "Company workbench files" "${dock_helper} files" "${workbench_root}"
write_dock_launcher browser 6 idle Browser "Company browser on this screen" "${dock_helper}" ""
cosmetic write_dock_launcher terminal 4 running Terminal "Shell in the company workbench" "${dock_helper} terminal" "${workbench_root}"
cosmetic write_dock_launcher files 5 running Files "Company workbench files" "${dock_helper} files" "${workbench_root}"
for state in launching launching-2 running failed; do
	cosmetic write_dock_launcher browser 6 "${state}" Browser "Company browser on this screen" "${dock_helper}" ""
done
# The office account carries no login shell; the terminal runs Bash explicitly.
# Its prompt shows the folder instead of "bash-5.3$" (a small rc file of this
# screen, which still reads the account's own ~/.bashrc first). A calm dark
# look, no menu bar, a roomier window. qorpera-screen-xfce repeats the look in
# xfconf, where newer xfce4-terminal versions keep their settings.
terminal_shell=/usr/bin/bash
terminal_rc="${screen_state}/config/qorpera-bashrc"
cosmetic write_desktop_file "${terminal_rc}" <<'BASHRC'
[[ ! -r ~/.bashrc ]] || . ~/.bashrc
PS1='\[\e[38;5;114m\]\w\[\e[0m\] \$ '
BASHRC
# The command line is split like a shell's: only a path that needs no escaping
# beyond the quotes is used.
plain_path='^[A-Za-z0-9/._ -]+$'
if [[ -f ${terminal_rc} && ! -L ${terminal_rc} && ${terminal_rc} =~ ${plain_path} ]]; then
	terminal_shell="/usr/bin/bash --rcfile \"${terminal_rc}\""
fi
write_desktop_file "${terminal_config}/terminalrc" <<TERMINAL
[Configuration]
RunCustomCommand=TRUE
CustomCommand=${terminal_shell}
MiscDefaultWorkingDir=
MiscMenubarDefault=FALSE
MiscDefaultGeometry=110x30
ScrollingBar=TERMINAL_SCROLLBAR_NONE
FontUseSystem=FALSE
FontName=DejaVu Sans Mono 11
ColorForeground=#e6e9ef
ColorBackground=#12141a
ColorCursor=#7ee787
ColorCursorUseDefault=FALSE
ColorPalette=#1b1f2a;#f47067;#7ee787;#f5a524;#5aa9ff;#c297ff;#56d4dd;#c9ced8;#565d6b;#ff938a;#a5f3ae;#ffd166;#8cc4ff;#d8b9ff;#8ae7ee;#ffffff
TERMINAL
rm -rf -- "${scratch}"
cd "${workbench_root}"
mkdir -p /tmp/.ICE-unix
chmod 1777 /tmp/.ICE-unix
xvnc_pid=""
session_pid=""
cleanup() {
	trap - EXIT TERM INT
	for child in "${session_pid}" "${xvnc_pid}"; do
		[[ -n ${child} ]] && kill -TERM -- "-${child}" 2>/dev/null || true
	done
	for (( attempt=0; attempt<30; attempt++ )); do
		alive=false
		for child in "${session_pid}" "${xvnc_pid}"; do
			if [[ -n ${child} ]] && kill -0 -- "-${child}" 2>/dev/null; then alive=true; fi
		done
		[[ ${alive} == false ]] && break
		sleep 0.1
	done
	for child in "${session_pid}" "${xvnc_pid}"; do
		if [[ -n ${child} ]]; then
			kill -KILL -- "-${child}" 2>/dev/null || true
			wait "${child}" 2>/dev/null || true
		fi
	done
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

# Both sockets are confined behind the guest broker. No TCP RFB/X listener,
# clipboard forwarding, resize or in-session configuration override is allowed.
# -noreset keeps the assigned X socket alive when the last client disconnects;
# -s 0 keeps the X screen saver from ever blanking a screen somebody may open.
/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 HOME="${desktop_home}" \
	/usr/bin/setsid /usr/bin/Xtigervnc "${display}" -rfbport -1 \
	-rfbunixpath "${runtime_dir}/viewer.sock" -rfbunixmode 0600 -nolisten tcp -ac -noreset -s 0 -rendernode '' \
	-SecurityTypes None -AlwaysShared -DisconnectClients=0 -AcceptSetDesktopSize=0 \
	-AcceptCutText=0 -SendCutText=0 -SendPrimary=0 -SetPrimary=0 -AllowOverride '' \
	-geometry 1920x1200 -depth 24 -desktop "Qorpera Screen ${ordinal}" >&2 &
xvnc_pid=$!
ready=false
for (( attempt=0; attempt<50; attempt++ )); do
	if DISPLAY=${display} /usr/bin/xset q >/dev/null 2>&1; then ready=true; break; fi
	if ! kill -0 "${xvnc_pid}" 2>/dev/null; then exit 1; fi
	sleep 0.2
done
if [[ ${ready} != true ]]; then echo "Display did not become ready." >&2; exit 1; fi

# Internet for the Terminal and what it starts: only the proxy settings the
# service supplied, pointing at the loopback proxy of this desktop's own,
# otherwise empty, network. A service without them leaves the desktop offline.
network=()
for name in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY NODE_USE_ENV_PROXY; do
	value=${!name-}
	if [[ ${value} =~ ^[A-Za-z0-9:/.,_-]{1,200}$ ]]; then network+=("${name}=${value}"); fi
done
/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 HOME="${desktop_home}" DISPLAY="${display}" \
	"${network[@]}" \
	SHELL=/usr/bin/bash TZ="${time_zone}" QORPERA_SCREEN_BACKDROPS="${backdrops}" \
	XDG_RUNTIME_DIR="${runtime_dir}" XDG_CONFIG_HOME="${screen_state}/config" \
	XDG_CACHE_HOME="${screen_state}/cache" XDG_DATA_HOME="${screen_state}/data" \
	/usr/bin/setsid /usr/bin/dbus-run-session -- /usr/local/bin/qorpera-screen-xfce "${wallpaper}" >&2 &
session_pid=$!
ready=false
for (( attempt=0; attempt<75; attempt++ )); do
	if ! kill -0 "${xvnc_pid}" 2>/dev/null || ! kill -0 "${session_pid}" 2>/dev/null; then exit 1; fi
	window_manager=$(DISPLAY=${display} /usr/bin/xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null || true)
	if [[ ${window_manager} =~ window\ id\ \#\ 0x[1-9a-f][0-9a-f]* ]]; then ready=true; break; fi
	sleep 0.2
done
if [[ ${ready} != true ]]; then echo "Desktop did not become ready." >&2; exit 1; fi
printf '{"schema":"qorpera.screen-ready/v1","screenId":"%s","ordinal":%s}\n' "${screen_id}" "${ordinal}"
# Bash 5 on the Linux image; either half ending tears down and reaps both groups.
wait -n "${xvnc_pid}" "${session_pid}"
