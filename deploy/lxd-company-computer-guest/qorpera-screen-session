Name=${name}
Comment=${comment}
Exec=${command}
${path}Icon=${dock_state}/${app}-${state}.png
Terminal=false
StartupNotify=false
DESKTOP
}
for state in idle running; do
	write_dock_launcher terminal "${state}" Terminal "Shell in the company workbench" xfce4-terminal "${workbench_root}"
	write_dock_launcher files "${state}" Files "Company workbench files" "thunar ." "${workbench_root}"
done
for state in idle running failed; do
	write_dock_launcher browser "${state}" Browser "Company browser on this screen" /usr/local/bin/qorpera-screen-browser ""
done
cp -f -- "${dock_state}/terminal.idle.desktop" "${launchers}/launcher-4/qorpera-terminal.desktop"
cp -f -- "${dock_state}/files.idle.desktop" "${launchers}/launcher-5/qorpera-files.desktop"
cp -f -- "${dock_state}/browser.idle.desktop" "${launchers}/launcher-6/qorpera-browser.desktop"
# The office account carries no login shell; the terminal runs Bash explicitly.
write_desktop_file "${terminal_config}/terminalrc" <<'TERMINAL'
[Configuration]
RunCustomCommand=TRUE
CustomCommand=/usr/bin/bash
MiscDefaultWorkingDir=
TERMINAL
cd "${workbench_root}"
mkdir -p /tmp/.ICE-unix
chmod 1777 /tmp/.ICE-unix
xvnc_pid=""
session_pid=""
cleanup() {
	trap - EXIT TERM INT
	for child in "${session_pid}" "${xvnc_pid}"; do
		[[ -n ${child} ]] && kill -TERM -- "-${child}" 2>/dev/null || true
	done
	for (( attempt=0; attempt<30; attempt++ )); do
		alive=false
		for child in "${session_pid}" "${xvnc_pid}"; do
			if [[ -n ${child} ]] && kill -0 -- "-${child}" 2>/dev/null; then alive=true; fi
		done
		[[ ${alive} == false ]] && break
		sleep 0.1
	done
	for child in "${session_pid}" "${xvnc_pid}"; do
		if [[ -n ${child} ]]; then
			kill -KILL -- "-${child}" 2>/dev/null || true
			wait "${child}" 2>/dev/null || true
		fi
	done
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

# Both sockets are confined behind the guest broker. No TCP RFB/X listener,
# clipboard forwarding, resize or in-session configuration override is allowed.
# -noreset keeps the assigned X socket alive when the last client disconnects;
# -s 0 keeps the X screen saver from ever blanking a screen somebody may open.
/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 HOME="${desktop_home}" \
	/usr/bin/setsid /usr/bin/Xtigervnc "${display}" -rfbport -1 \
	-rfbunixpath "${runtime_dir}/viewer.sock" -rfbunixmode 0600 -nolisten tcp -ac -noreset -s 0 -rendernode '' \
	-SecurityTypes None -AlwaysShared -DisconnectClients=0 -AcceptSetDesktopSize=0 \
	-AcceptCutText=0 -SendCutText=0 -SendPrimary=0 -SetPrimary=0 -AllowOverride '' \
	-geometry 1920x1200 -depth 24 -desktop "Qorpera Screen ${ordinal}" >&2 &
xvnc_pid=$!
ready=false
for (( attempt=0; attempt<50; attempt++ )); do
	if DISPLAY=${display} /usr/bin/xset q >/dev/null 2>&1; then ready=true; break; fi
	if ! kill -0 "${xvnc_pid}" 2>/dev/null; then exit 1; fi
	sleep 0.2
done
if [[ ${ready} != true ]]; then echo "Display did not become ready." >&2; exit 1; fi

/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 HOME="${desktop_home}" DISPLAY="${display}" \
	SHELL=/usr/bin/bash TZ="${time_zone}" QORPERA_SCREEN_BACKDROPS="${backdrops}" \
	XDG_RUNTIME_DIR="${runtime_dir}" XDG_CONFIG_HOME="${screen_state}/config" \
	XDG_CACHE_HOME="${screen_state}/cache" XDG_DATA_HOME="${screen_state}/data" \
	/usr/bin/setsid /usr/bin/dbus-run-session -- /usr/local/bin/qorpera-screen-xfce "${wallpaper}" >&2 &
session_pid=$!
ready=false
for (( attempt=0; attempt<75; attempt++ )); do
	if ! kill -0 "${xvnc_pid}" 2>/dev/null || ! kill -0 "${session_pid}" 2>/dev/null; then exit 1; fi
	window_manager=$(DISPLAY=${display} /usr/bin/xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null || true)
	if [[ ${window_manager} =~ window\ id\ \#\ 0x[1-9a-f][0-9a-f]* ]]; then ready=true; break; fi
	sleep 0.2
done
if [[ ${ready} != true ]]; then echo "Desktop did not become ready." >&2; exit 1; fi
printf '{"schema":"qorpera.screen-ready/v1","screenId":"%s","ordinal":%s}\n' "${screen_id}" "${ordinal}"
# Bash 5 on the Linux image; either half ending tears down and reaps both groups.
wait -n "${xvnc_pid}" "${session_pid}"
