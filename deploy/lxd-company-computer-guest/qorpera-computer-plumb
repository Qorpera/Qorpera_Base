#!/usr/bin/env bash
# Root. Each computer's own network: a veth whose machine end is
# qcmp<ordinal><s|d>, filtered by qorpera-computer-network.nft. Computers leave
# by the machine's agent card `qagent` (its second card, a port of the node's
# agents' bridge), through the node's agent exit, never by its first card.
#
#   qorpera-computer-plumb --up     load the firewall, address and route the agent card, then turn forwarding on
#   qorpera-computer-plumb --down   remove every computer's link, the agent card's routes and address, then the firewall
#   qorpera-computer-plumb          one request on stdin (qorpera-computer-plumb.socket):
#     request: plumb <ordinal 1-32> <shell|desktop> <pid in that namespace>
#     answer:  ok <address>   or   refused <reason>
#
# The office service runs unprivileged and cannot create network devices; it
# creates the namespace with Bubblewrap and asks here while the namespace's
# program still waits at its start gate. Only such a namespace of the office
# account is plumbed: under /usr/bin/bwrap (never the browser's own copy, whose
# network is its relay), not this machine's own, with no link yet. Nothing is
# plumbed without the machine's firewall and agent card, and every computer
# also gets a filter of its own inside its namespace, which it cannot change.
#
# One step at a time on this machine (requests, --up and --down), so a late
# request never undoes a newer one. The lock is this file itself, which only
# root can open (installed 0500): no computer can hold it.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
nft_file=${QORPERA_COMPUTER_NETWORK_NFT:-/usr/local/share/qorpera/computer-network.nft}
office_user=${QORPERA_OFFICE_USER:-qorpera-office}
refuse() {
	printf 'refused %s\n' "$1"
	exit 0
}
# Every link of ours on this machine.
links() {
	ip -o link show | sed -n 's/^[0-9]*: \(qcmp[0-9]*[sd]\)@.*/\1/p'
}
# The agent card's address, from its MAC: the node's plug tool gives a machine
# 10.210.X.Y with the MAC 0e:51:0a:d2:XX:YY (agent-plug.ts), and the exit lets
# that MAC speak for that address only. Nothing without a card it gave.
plug_address() {
	local mac
	mac=$(</sys/class/net/qagent/address) || return 1
	[[ ${mac} =~ ^0e:51:0a:d2:([0-9a-f]{2}):([0-9a-f]{2})$ ]] || return 1
	local third=$((16#${BASH_REMATCH[1]})) fourth=$((16#${BASH_REMATCH[2]}))
	((third > 0 && fourth > 0 && fourth < 255)) || return 1
	printf '10.210.%d.%d' "${third}" "${fourth}"
}
# The agent card's routing, at fixed priorities: replies to the computers stay
# on this machine's own routes; the computers' and the card's own traffic use
# table 210, whose only way out is the exit (10.210.0.1). Should these go, that
# traffic finds the first card's route and the firewall drops it there.
unroute() {
	local priority
	for priority in 1000 1001 1002; do
		while ip rule del priority "${priority}" 2>/dev/null; do :; done
	done
	ip route flush table 210 2>/dev/null || true
}
exec 9<"${BASH_SOURCE[0]}"

case ${1-} in
--up)
	flock 9
	plug=$(plug_address) || {
		echo "qorpera-computer-plumb: no agent card (qagent with a plug's MAC)" >&2
		exit 1
	}
	nft -f "${nft_file}"
	# Room for every computer's connections (the firewall bounds them) and the
	# machine's own. Only the machine's own kernel may raise it.
	sysctl -q -w net.netfilter.nf_conntrack_max=262144 2>/dev/null || true
	# No redirects from any interface: the kernel ORs "all" with each one's own.
	sysctl -q -w net.ipv4.conf.default.send_redirects=0
	for setting in /proc/sys/net/ipv4/conf/*/send_redirects; do printf 0 >"${setting}"; done
	# The card answers and asks ARP for its own address only (the exit checks
	# both), and has no IPv6. Its address has no route in the main table.
	sysctl -q -w net.ipv6.conf.qagent.disable_ipv6=1 net.ipv4.conf.qagent.arp_ignore=1 \
		net.ipv4.conf.qagent.arp_announce=2
	ip link set qagent up
	while read -r _ _ _ address _; do
		[[ ${address} == "${plug}/16" ]] || ip addr del "${address}" dev qagent
	done < <(ip -o -4 addr show dev qagent)
	ip addr replace "${plug}/16" dev qagent noprefixroute
	unroute
	ip route add 10.210.0.0/16 dev qagent src "${plug}" table 210
	ip route add default via 10.210.0.1 dev qagent src "${plug}" table 210
	ip rule add priority 1000 to 10.253.0.0/16 lookup main
	ip rule add priority 1001 from 10.253.0.0/16 lookup 210
	ip rule add priority 1002 from "${plug}" lookup 210
	sysctl -q -w net.ipv4.ip_forward=1
	exit 0
	;;
--down)
	flock 9
	for link in $(links); do ip link del "${link}" 2>/dev/null || true; done
	sysctl -q -w net.ipv4.ip_forward=0
	# The card's way out goes before the firewall that keeps it to the card.
	unroute
	ip -4 addr flush dev qagent 2>/dev/null || true
	nft delete table inet qorpera_computers 2>/dev/null || true
	exit 0
	;;
'') ;;
*) exit 2 ;;
esac

IFS= read -r -t 5 request || refuse request
[[ ${request} =~ ^plumb\ ([1-9]|[12][0-9]|3[0-2])\ (shell|desktop)\ ([1-9][0-9]{0,9})$ ]] || refuse request
ordinal=${BASH_REMATCH[1]}
role=${BASH_REMATCH[2]}
pid=${BASH_REMATCH[3]}
flock -w 10 9 || refuse busy

# The machine's firewall is loaded: its input, forward and output chains as shipped.
input=$(nft list chain inet qorpera_computers input 2>/dev/null) || refuse firewall
forward=$(nft list chain inet qorpera_computers forward 2>/dev/null) || refuse firewall
output=$(nft list chain inet qorpera_computers output 2>/dev/null) || refuse firewall
nft list chain inet qorpera_computers postrouting >/dev/null 2>&1 || refuse firewall
[[ ${input} == *'iifname "qcmp*" drop'* && ${forward} == *'policy drop;'* ]] || refuse firewall
[[ ${forward} == *'iifname "qcmp*" oifname != "qagent" drop'* ]] || refuse firewall
[[ ${output} == *'ip saddr 10.210.0.0/16 oifname != "qagent" drop'* ]] || refuse firewall
# The agent card has its address and the computers' way out through it.
plug=$(plug_address) || refuse plug
[[ $(ip -o -4 addr show dev qagent) == *" inet ${plug}/16 "* ]] || refuse plug
[[ $(ip rule show priority 1001) == *'from 10.253.0.0/16 lookup 210'* ]] || refuse plug
# Our addresses overlap nothing else on this machine.
while read -r _ name _ address _; do
	[[ ${name} =~ ^qcmp[0-9]+[sd]$ || ${address} != 10.253.* ]] || refuse addresses
done < <(ip -o -4 addr show)

office_uid=$(id -u "${office_user}") || refuse account
own=$(readlink /proc/1/ns/net)
# The namespace's first process (Tini) under /usr/bin/bwrap, its only child
# still at the start gate of cloud-company-computer-linux-process.ts.
held() {
	local stat parent children args
	[[ -d /proc/${pid} ]] || return 1
	[[ $(stat -c %u "/proc/${pid}") == "${office_uid}" ]] || return 1
	[[ $(readlink "/proc/${pid}/exe") == /usr/bin/tini ]] || return 1
	stat=$(<"/proc/${pid}/stat") || return 1
	read -r _ parent _ <<<"${stat##*) }"
	[[ $(readlink "/proc/${parent}/exe") == /usr/bin/bwrap ]] || return 1
	children=$(<"/proc/${pid}/task/${pid}/children") || return 1
	[[ ${children} =~ ^([0-9]+)\ ?$ ]] || return 1
	[[ $(readlink "/proc/${BASH_REMATCH[1]}/exe") == /usr/bin/bash ]] || return 1
	mapfile -d '' -t args <"/proc/${BASH_REMATCH[1]}/cmdline" || return 1
	[[ ${#args[@]} -gt 5 && ${args[5]} == qorpera-office-launch ]] || return 1
}
held || refuse process
target=$(readlink "/proc/${pid}/ns/net") || refuse process
[[ ${target} != "${own}" ]] || refuse namespace
# A fresh namespace only: nothing of ours in it yet.
if [[ -n $(nsenter -t "${pid}" -n ip -o link show type veth) ]]; then refuse namespace; fi
if [[ ${role} == shell ]]; then
	host=qcmp${ordinal}s
	host_ip=10.253.${ordinal}.1
	peer_ip=10.253.${ordinal}.2
else
	host=qcmp${ordinal}d
	host_ip=10.253.${ordinal}.5
	peer_ip=10.253.${ordinal}.6
fi
# The same computer's previous shell or desktop, if its namespace is still going away.
ip link del "${host}" 2>/dev/null || true
ip link add "${host}" type veth peer name eth0 netns "${pid}"
ip addr add "${host_ip}/30" dev "${host}"
ip link set "${host}" up
# Inside: its own filter first, then the address and route, ping for the
# namespace's own users, and no IPv6 on its way out (loopback keeps ::1).
nsenter -t "${pid}" -n nft -f - <<'EOF'
table inet qorpera_computer {
	set blocked {
		type ipv4_addr
		flags interval
		elements = {
			0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
			192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15,
			198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4
		}
	}
	chain output {
		type filter hook output priority filter; policy accept;
		oifname "lo" accept
		meta nfproto ipv6 drop
		ip daddr 10.210.0.1 udp dport 53 accept
		ip daddr 10.210.0.1 tcp dport 53 accept
		ip daddr @blocked drop
	}
}
EOF
nsenter -t "${pid}" -n sysctl -q -w net.ipv6.conf.eth0.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1
nsenter -t "${pid}" -n ip addr add "${peer_ip}/30" dev eth0
nsenter -t "${pid}" -n ip link set eth0 up
nsenter -t "${pid}" -n ip route add default via "${host_ip}"
nsenter -t "${pid}" -n sysctl -q -w net.ipv4.ping_group_range="0 2147483647"
# The process must still be the one asked about, still waiting at its gate.
if ! held || [[ $(readlink "/proc/${pid}/ns/net" 2>/dev/null) != "${target}" ]]; then
	ip link del "${host}" 2>/dev/null || true
	refuse namespace
fi
printf 'ok %s\n' "${peer_ip}"
