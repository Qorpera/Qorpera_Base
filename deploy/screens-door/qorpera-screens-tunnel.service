[Unit]
Description=Qorpera live pictures: node 1's own Cloudflare tunnel to the executor's live-picture listener
Documentation=https://github.com/Qorpera/Qorpera_Base/blob/master/deploy/screens-door/README.md
Wants=network-online.target
After=network-online.target
# No token sealed on this host (qorpera-screens-door token): it does not start.
ConditionPathExists=/etc/credstore.encrypted/qorpera-screens-tunnel

[Service]
Type=simple
# The tunnel's token, sealed with this host's own key (and its TPM, when it has one): decrypted by systemd into this
# unit's own credentials directory, never on a command line, in the environment or on disk in the clear. With the host
# key alone, that key is a file on this same unencrypted disk: the seal keeps the token from being read in passing, from
# a copy of that one file and from other hosts, not from whoever holds the whole disk or root here (`qorpera-screens-door
# status` says which key sealed it).
LoadCredentialEncrypted=token:/etc/credstore.encrypted/qorpera-screens-tunnel
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20242 run --token-file ${CREDENTIALS_DIRECTORY}/token
Restart=on-failure
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# It reaches the executor's live-picture listener on the loopback and Cloudflare's tunnel edge on 7844, nothing else:
# region1 and region2 of v2.argotunnel.com as Cloudflare publishes them (developers.cloudflare.com, Cloudflare One,
# "Tunnel with firewall", read 13 Nov 2026): the two IPv4 /24s that hold their twenty published IPv4 addresses, and
# their twenty published IPv6 addresses, each by itself. The connector dials the edge over IPv4 unless told otherwise.
IPAddressDeny=any
IPAddressAllow=localhost 198.41.192.0/24 198.41.200.0/24
IPAddressAllow=2606:4700:a0::1 2606:4700:a0::2 2606:4700:a0::3 2606:4700:a0::4 2606:4700:a0::5 2606:4700:a0::6 2606:4700:a0::7 2606:4700:a0::8 2606:4700:a0::9 2606:4700:a0::10
IPAddressAllow=2606:4700:a8::1 2606:4700:a8::2 2606:4700:a8::3 2606:4700:a8::4 2606:4700:a8::5 2606:4700:a8::6 2606:4700:a8::7 2606:4700:a8::8 2606:4700:a8::9 2606:4700:a8::10
UMask=0077
LogLevelMax=info

[Install]
WantedBy=multi-user.target
