[Unit]
Description=Qorpera Company Data Base Backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/qorpera-company-data/kit
ExecStart=/bin/bash /opt/qorpera-company-data/kit/base-backup.sh
TimeoutStartSec=4h
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
