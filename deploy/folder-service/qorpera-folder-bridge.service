[Unit]
Description=Qorpera folder bridge (machines' vsock link to this node's folder service)
Documentation=file:///opt/qorpera-folder-service/README.md
Requires=qorpera-folder-service.socket
After=qorpera-folder-service.socket

[Service]
Type=exec
User=qorpera-folder-bridge
Group=qorpera-folder-bridge
# Holds no credential and reads nothing: it names each machine's CID to the service and passes bytes through.
ExecStart=/opt/qorpera-folder-service/qorpera-folder bridge --service unix:/run/qorpera-folder/service.sock --listen vsock:any:5250
Restart=always
RestartSec=2s
TimeoutStopSec=10s
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_VSOCK
MemoryMax=512M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
