[Unit]
Description=Qorpera folder service (company folders for this node's machines, memory only)
Documentation=file:///opt/qorpera-folder-service/README.md
Requires=qorpera-folder-service.socket
Wants=network-online.target
After=network-online.target qorpera-folder-service.socket snap.lxd.daemon.service
RequiresMountsFor=/srv/qorpera/canonical
ConditionPathExists=/etc/qorpera-folder-service/config.json
# Never give up restarting: every mount on the node depends on it, and it keeps nothing to lose.
StartLimitIntervalSec=0

[Service]
Type=exec
User=qorpera-folder
Group=qorpera-folder
# The objects on the share are written 0600 by the object gateway's account, qorpera-objects. A drop-in gives the
# service that account and a process namespace of its own, and hides the gateway's tokens and state; see README.md.
LoadCredential=qorpera-folder-config:/etc/qorpera-folder-service/config.json
LoadCredential=qorpera-supabase-service-key:/etc/qorpera-folder-service/supabase-key
# Object reads run on libuv's pool; a hung NFS read holds a thread until it returns.
Environment=UV_THREADPOOL_SIZE=32
# CommonJS and node:https, never fetch: fetch needs WebAssembly, which --jitless removes.
ExecStart=/usr/bin/node --jitless /opt/qorpera-folder-service/qorpera-folder-service.cjs
Restart=on-failure
RestartSec=5s
# On a node with coding machines, qorpera-folder-control.socket (enabled there alone) passes its socket too, by its
# Service=. A stop releases and publishes the coding views first, for up to 45 s (cli.ts), so the next run may serve them.
TimeoutStopSec=60s
# A clean stop leaves the next run its note here (clean-stop.ts): kept across every stop and start (systemd removes it
# at a stop otherwise, a restart included), gone at a boot. A run without one counts every machine lost until it restarts.
RuntimeDirectory=qorpera-folder-service
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
KillMode=mixed
UMask=0077
# No core file: it would hold company bytes.
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=3G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
