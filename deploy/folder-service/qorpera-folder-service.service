[Unit]
Description=Qorpera folder service (company folders for this node's machines, memory only)
Documentation=file:///opt/qorpera-folder-service/README.md
Requires=qorpera-folder-service.socket
Wants=network-online.target
After=network-online.target qorpera-folder-service.socket snap.lxd.daemon.service
RequiresMountsFor=/srv/qorpera/canonical
ConditionPathExists=/etc/qorpera-folder-service/config.json
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=qorpera-folder
Group=qorpera-folder
# Fixed read requests to LXD (one instance's CID per machine connection). The socket group is root-equivalent:
# this account is part of the node's trusted boundary, as the node observer's is.
SupplementaryGroups=lxd
# The objects on the share are written 0600 by the object gateway's account. Reading them needs that uid (a drop-in
# User=, decided at install) or a read grant on the storage server; see README.md.
LoadCredential=qorpera-folder-config:/etc/qorpera-folder-service/config.json
LoadCredential=qorpera-supabase-service-key:/etc/qorpera-folder-service/supabase-key
# Object reads run on libuv's pool; a hung NFS read holds a thread until it returns.
Environment=UV_THREADPOOL_SIZE=32
ExecStart=/usr/bin/node --jitless /opt/qorpera-folder-service/qorpera-folder-service.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=mixed
UMask=0077
# No core file: it would hold company bytes.
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=3G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
