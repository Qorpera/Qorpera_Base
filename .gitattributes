# Default to LF for text files across the repo
* text=auto eol=lf

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should keep LF
*.sh text eol=lf

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary

# Pinned model data for CI: generated, so fold it in GitHub diffs.
.github/model-data/*.json linguist-generated=true

# Unified-diff blank context lines retain their required leading space.
# The native artifact verifier pins this patch's exact bytes separately.
deploy/first-node/native-codex/0001-cloud-result-fence.patch whitespace=-blank-at-eol
