{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": [
				"./*"
			],
			"@qorpera/contracts": [
				"./packages/contracts/src/index.ts"
			],
			"@qorpera/contracts/*": [
				"./packages/contracts/src/*"
			],
			"@qorpera/company": [
				"./packages/company/src/index.ts"
			],
			"@qorpera/company/*": [
				"./packages/company/src/*.ts"
			],
			"@qorpera/runner-orchestrator": [
				"./packages/runner-orchestrator/src/index.ts"
			],
			"@qorpera/runtime": [
				"./packages/runtime/src/index.ts"
			],
			"@qorpera/runtime/*": [
				"./packages/runtime/src/*.ts"
			],
			"@qorpera/cloud-client": [
				"./packages/cloud-client/src/index.ts"
			],
			"@qorpera/cloud-client/*": [
				"./packages/cloud-client/src/*.ts"
			]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*"
	],
	"exclude": [
		"packages/web/src/**",
		"packages/web/test/**",
		"packages/member-web/src/**",
		"packages/member-web/test/**",
		"**/dist/**"
	]
}
